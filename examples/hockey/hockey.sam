oCheck@ = [5, 6, 7]

' Fight stats per roster slot (1-10)
wFight@ = [6, 4, 8]
oFight@ = [5, 6, 7]

' Check cooldown
checkCooldown# = 0

' Goalie hold timer (when goalie picked up puck)
