' Opponent (right side)
pX@[5] = 610
pY@[5] = 240
pDir@[5] = -1
pX@[6] = 700
pY@[6] = 160
pDir@[6] = -1
pX@[7] = 700
pY@[7] = 320
pDir@[7] = -1
pX@[8] = 1085
pY@[8] = 240
