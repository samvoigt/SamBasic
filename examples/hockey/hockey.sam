' ============================================
'   WHALERS HOCKEY
'   Arrow keys to move, X to switch player
' ============================================

' ============ CONSTANTS ============
SCREEN_W# = 640
SCREEN_H# = 480

' Rink (world coordinates)
RINK_W# = 1200
RINK_H# = 400
RINK_TOP# = 40
BOARD_THICKNESS# = 12
ICE_LEFT# = 20
ICE_RIGHT# = 1180
ICE_TOP# = 52
ICE_BOTTOM# = 428

' Goal dimensions
GOAL_W# = 8
GOAL_H# = 60
GOAL_LEFT_X# = 60
GOAL_RIGHT_X# = 1140

' Lines
CENTER_X# = 600
BLUE_LEFT_X# = 450
BLUE_RIGHT_X# = 750
LINE_HALF# = 2
CORNER_R# = 60
ICE_CORNER_R# = 48
CREASE_COLOR& = {.r# = 153, .g# = 204, .b# = 255}
INDICATOR_COLOR& = {.r# = 130, .g# = 200, .b# = 255, .a# = 100}

' Benches (along top boards, between blue lines)
BENCH_Y1# = 8
BENCH_Y2# = 40
BENCH_GAP# = 20
BENCH_LEFT_X1# = 460
BENCH_LEFT_X2# = 590
BENCH_RIGHT_X1# = 610
BENCH_RIGHT_X2# = 740
BENCH_COLOR& = {.r# = 60, .g# = 40, .b# = 20}
BENCH_SEAT_COLOR& = {.r# = 100, .g# = 70, .b# = 40}

' Player/sprite constants
PLAYER_SCALE# = 3
PUCK_SCALE# = 2
NUM_PLAYERS# = 8
PLAYER_FRICTION# = 0.92
PUCK_FRICTION# = 0.995
SHOT_CHARGE_TIME# = 800
SHOT_POWER_MIN# = 5
SHOT_POWER_MAX# = 15
PASS_SPEED# = 14

' ============ SPRITES ============
' Run sprites.sam first to write these to localStorage

' Skater sprites (3 skating frames, 3 shooting frames per team)
wSkate@ = SIZE 3
wSkate@[1] = LOADSPRITE# FILE "hockey-w-skate1.spr"
wSkate@[2] = LOADSPRITE# FILE "hockey-w-skate2.spr"
wSkate@[3] = LOADSPRITE# FILE "hockey-w-skate3.spr"
wShoot@ = SIZE 3
wShoot@[1] = LOADSPRITE# FILE "hockey-w-shoot1.spr"
wShoot@[2] = LOADSPRITE# FILE "hockey-w-shoot2.spr"
wShoot@[3] = LOADSPRITE# FILE "hockey-w-shoot3.spr"

oSkate@ = SIZE 3
oSkate@[1] = LOADSPRITE# FILE "hockey-o-skate1.spr"
oSkate@[2] = LOADSPRITE# FILE "hockey-o-skate2.spr"
oSkate@[3] = LOADSPRITE# FILE "hockey-o-skate3.spr"
oShoot@ = SIZE 3
oShoot@[1] = LOADSPRITE# FILE "hockey-o-shoot1.spr"
oShoot@[2] = LOADSPRITE# FILE "hockey-o-shoot2.spr"
oShoot@[3] = LOADSPRITE# FILE "hockey-o-shoot3.spr"

' Goalie sprites (idle + 3 save types x 2 frames each)
wGoalieId# = LOADSPRITE# FILE "hockey-w-goalie.spr"
wGoalieGlove@ = SIZE 2
wGoalieGlove@[1] = LOADSPRITE# FILE "hockey-w-goalie-glove1.spr"
wGoalieGlove@[2] = LOADSPRITE# FILE "hockey-w-goalie-glove2.spr"
wGoalieBlocker@ = SIZE 2
wGoalieBlocker@[1] = LOADSPRITE# FILE "hockey-w-goalie-blocker1.spr"
wGoalieBlocker@[2] = LOADSPRITE# FILE "hockey-w-goalie-blocker2.spr"
wGoalieSplit@ = SIZE 2
wGoalieSplit@[1] = LOADSPRITE# FILE "hockey-w-goalie-split1.spr"
wGoalieSplit@[2] = LOADSPRITE# FILE "hockey-w-goalie-split2.spr"

oGoalieId# = LOADSPRITE# FILE "hockey-o-goalie.spr"
oGoalieGlove@ = SIZE 2
oGoalieGlove@[1] = LOADSPRITE# FILE "hockey-o-goalie-glove1.spr"
oGoalieGlove@[2] = LOADSPRITE# FILE "hockey-o-goalie-glove2.spr"
oGoalieBlocker@ = SIZE 2
oGoalieBlocker@[1] = LOADSPRITE# FILE "hockey-o-goalie-blocker1.spr"
oGoalieBlocker@[2] = LOADSPRITE# FILE "hockey-o-goalie-blocker2.spr"
oGoalieSplit@ = SIZE 2
oGoalieSplit@[1] = LOADSPRITE# FILE "hockey-o-goalie-split1.spr"
oGoalieSplit@[2] = LOADSPRITE# FILE "hockey-o-goalie-split2.spr"

puckSprId# = LOADSPRITE# FILE "hockey-puck.spr"

' ============ ANIMATION CONSTANTS ============
' Animation states
ANIM_SKATE# = 0
ANIM_SHOOT# = 1
ANIM_GOALIE_IDLE# = 2
ANIM_GOALIE_GLOVE# = 3
ANIM_GOALIE_BLOCKER# = 4
ANIM_GOALIE_SPLIT# = 5

' Timing (in frames at ~60fps)
SKATE_FRAME_TIME# = 8
SHOOT_FRAME_TIME# = 6
GOALIE_FRAME_TIME# = 10

' ============ STATE ============
camX# = 0
puckX# = 600
puckY# = 240
puckLoose? = YES
puckOwner# = 0

' On-ice player state (1-4 Whalers, 5-8 Opponent)
' Index 4 = Whalers goalie, 8 = Opponent goalie
pX@ = SIZE 8
pY@ = SIZE 8
pVX@ = SIZE 8
pVY@ = SIZE 8
pDir@ = SIZE 8
pState@ = SIZE 8
pHasPuck@ = SIZE 8
activeP# = 1

' Animation state per player
pAnim@ = SIZE 8
pAnimFrame@ = SIZE 8
pAnimTimer@ = SIZE 8
FOR i# FROM 1 TO 8
  pAnimFrame@[i#] = 1
  pAnimTimer@[i#] = 0
END FOR
' Goalies start in idle
pAnim@[4] = ANIM_GOALIE_IDLE#
pAnim@[8] = ANIM_GOALIE_IDLE#

' Placeholder roster data (speed stats 1-10 for each skater slot)
pRoster@ = [1, 2, 3, 0, 1, 2, 3, 0]
wSpeed@ = [7, 6, 8]
oSpeed@ = [6, 5, 7]

' Input state
inputX# = 0
inputY# = 0
inputShoot? = NO
inputPass? = NO
prevPass? = NO
passPressed? = NO

' Stun timers
pStateT@ = SIZE 8

' Whether each player is actively pushing (vs coasting)
pPushing@ = SIZE 8

' Puck physics
puckVX# = 0
puckVY# = 0
puckFreezeUntil# = 0

' Shooting state
shotCharging? = NO
shotChargeStart# = 0

' Passing state
passInFlight? = NO
passTime# = 0

' Score and game state
scoreW# = 0
scoreO# = 0
now# = 0

' Shot stats per roster slot (1-10)
wShot@ = [7, 8, 6]
oShot@ = [6, 5, 7]

' Initial positions (center-ice faceoff)
' Whalers (left side): C at faceoff, wings spread, goalie in net
pX@[1] = 590
pY@[1] = 240
pDir@[1] = 1
pX@[2] = 500
pY@[2] = 160
pDir@[2] = 1
pX@[3] = 500
pY@[3] = 320
pDir@[3] = 1
pX@[4] = 80
pY@[4] = 240
pDir@[4] = 1

' Opponent (right side)
pX@[5] = 610
pY@[5] = 240
pDir@[5] = -1
pX@[6] = 700
pY@[6] = 160
pDir@[6] = -1
pX@[7] = 700
pY@[7] = 320
pDir@[7] = -1
pX@[8] = 1120
pY@[8] = 240
pDir@[8] = -1

' ============ FUNCTIONS ============

FUNCTION updateCamera
  ' Target: center active player horizontally on screen
  targetCamX# = pX@[activeP#] - SCREEN_W# / 2

  ' Clamp to rink bounds
  targetCamX# = MAX# A targetCamX#, B 0
  targetCamX# = MIN# A targetCamX#, B (RINK_W# - SCREEN_W#)

  ' Smooth follow (lerp)
  camX# = camX# + (targetCamX# - camX#) * 0.08
END FUNCTION

FUNCTION collidePuck
  ' Straight wall clamping
  puckX# = MAX# A puckX#, B ICE_LEFT#
  puckX# = MIN# A puckX#, B ICE_RIGHT#
  puckY# = MAX# A puckY#, B ICE_TOP#
  puckY# = MIN# A puckY#, B ICE_BOTTOM#

  ' Corner circle centers
  cLeftX# = ICE_LEFT# + ICE_CORNER_R#
  cRightX# = ICE_RIGHT# - ICE_CORNER_R#
  cTopY# = ICE_TOP# + ICE_CORNER_R#
  cBotY# = ICE_BOTTOM# - ICE_CORNER_R#

  ' Top-left corner
  IF puckX# < cLeftX# AND puckY# < cTopY# THEN
    dx# = puckX# - cLeftX#
    dy# = puckY# - cTopY#
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)
    IF dist# > ICE_CORNER_R# THEN
      puckX# = cLeftX# + dx# / dist# * ICE_CORNER_R#
      puckY# = cTopY# + dy# / dist# * ICE_CORNER_R#
    END IF
  END IF

  ' Top-right corner
  IF puckX# > cRightX# AND puckY# < cTopY# THEN
    dx# = puckX# - cRightX#
    dy# = puckY# - cTopY#
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)
    IF dist# > ICE_CORNER_R# THEN
      puckX# = cRightX# + dx# / dist# * ICE_CORNER_R#
      puckY# = cTopY# + dy# / dist# * ICE_CORNER_R#
    END IF
  END IF

  ' Bottom-left corner
  IF puckX# < cLeftX# AND puckY# > cBotY# THEN
    dx# = puckX# - cLeftX#
    dy# = puckY# - cBotY#
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)
    IF dist# > ICE_CORNER_R# THEN
      puckX# = cLeftX# + dx# / dist# * ICE_CORNER_R#
      puckY# = cBotY# + dy# / dist# * ICE_CORNER_R#
    END IF
  END IF

  ' Bottom-right corner
  IF puckX# > cRightX# AND puckY# > cBotY# THEN
    dx# = puckX# - cRightX#
    dy# = puckY# - cBotY#
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)
    IF dist# > ICE_CORNER_R# THEN
      puckX# = cRightX# + dx# / dist# * ICE_CORNER_R#
      puckY# = cBotY# + dy# / dist# * ICE_CORNER_R#
    END IF
  END IF
END FUNCTION

FUNCTION drawRink
  ' Boards (dark gray rounded rectangle)
  SETCOLOR DARKGRAY&
  bx1# = 0 - camX#
  by1# = RINK_TOP#
  bx2# = RINK_W# - camX#
  by2# = RINK_TOP# + RINK_H#
  DRAWBOX X1 (bx1# + CORNER_R#), Y1 by1#, X2 (bx2# - CORNER_R#), Y2 by2#, FILL YES
  DRAWBOX X1 bx1#, Y1 (by1# + CORNER_R#), X2 bx2#, Y2 (by2# - CORNER_R#), FILL YES
  DRAWCIRCLE X (bx1# + CORNER_R#), Y (by1# + CORNER_R#), RADIUS CORNER_R#, FILL YES
  DRAWCIRCLE X (bx2# - CORNER_R#), Y (by1# + CORNER_R#), RADIUS CORNER_R#, FILL YES
  DRAWCIRCLE X (bx1# + CORNER_R#), Y (by2# - CORNER_R#), RADIUS CORNER_R#, FILL YES
  DRAWCIRCLE X (bx2# - CORNER_R#), Y (by2# - CORNER_R#), RADIUS CORNER_R#, FILL YES

  ' Player benches (top side, between blue lines)
  ' Home bench (left of center)
  SETCOLOR BENCH_COLOR&
  DRAWBOX X1 (BENCH_LEFT_X1# - camX#), Y1 BENCH_Y1#, X2 (BENCH_LEFT_X2# - camX#), Y2 BENCH_Y2#, FILL YES
  SETCOLOR BENCH_SEAT_COLOR&
  DRAWBOX X1 (BENCH_LEFT_X1# + 3 - camX#), Y1 (BENCH_Y1# + 3), X2 (BENCH_LEFT_X2# - 3 - camX#), Y2 (BENCH_Y2# - 3), FILL YES
  ' Away bench (right of center)
  SETCOLOR BENCH_COLOR&
  DRAWBOX X1 (BENCH_RIGHT_X1# - camX#), Y1 BENCH_Y1#, X2 (BENCH_RIGHT_X2# - camX#), Y2 BENCH_Y2#, FILL YES
  SETCOLOR BENCH_SEAT_COLOR&
  DRAWBOX X1 (BENCH_RIGHT_X1# + 3 - camX#), Y1 (BENCH_Y1# + 3), X2 (BENCH_RIGHT_X2# - 3 - camX#), Y2 (BENCH_Y2# - 3), FILL YES

  ' Ice surface (white rounded rectangle)
  SETCOLOR WHITE&
  ix1# = ICE_LEFT# - camX#
  iy1# = ICE_TOP#
  ix2# = ICE_RIGHT# - camX#
  iy2# = ICE_BOTTOM#
  DRAWBOX X1 (ix1# + ICE_CORNER_R#), Y1 iy1#, X2 (ix2# - ICE_CORNER_R#), Y2 iy2#, FILL YES
  DRAWBOX X1 ix1#, Y1 (iy1# + ICE_CORNER_R#), X2 ix2#, Y2 (iy2# - ICE_CORNER_R#), FILL YES
  DRAWCIRCLE X (ix1# + ICE_CORNER_R#), Y (iy1# + ICE_CORNER_R#), RADIUS ICE_CORNER_R#, FILL YES
  DRAWCIRCLE X (ix2# - ICE_CORNER_R#), Y (iy1# + ICE_CORNER_R#), RADIUS ICE_CORNER_R#, FILL YES
  DRAWCIRCLE X (ix1# + ICE_CORNER_R#), Y (iy2# - ICE_CORNER_R#), RADIUS ICE_CORNER_R#, FILL YES
  DRAWCIRCLE X (ix2# - ICE_CORNER_R#), Y (iy2# - ICE_CORNER_R#), RADIUS ICE_CORNER_R#, FILL YES

  ' Goal lines (thin red)
  SETCOLOR RED&
  DRAWLINE X1 (GOAL_LEFT_X# - camX#), Y1 ICE_TOP#, X2 (GOAL_LEFT_X# - camX#), Y2 ICE_BOTTOM#
  DRAWLINE X1 (GOAL_RIGHT_X# - camX#), Y1 ICE_TOP#, X2 (GOAL_RIGHT_X# - camX#), Y2 ICE_BOTTOM#

  ' Center red line (thick)
  lx# = CENTER_X# - camX#
  DRAWBOX X1 (lx# - LINE_HALF#), Y1 ICE_TOP#, X2 (lx# + LINE_HALF#), Y2 ICE_BOTTOM#, FILL YES

  ' Blue lines (thick)
  SETCOLOR BLUE&
  lx# = BLUE_LEFT_X# - camX#
  DRAWBOX X1 (lx# - LINE_HALF#), Y1 ICE_TOP#, X2 (lx# + LINE_HALF#), Y2 ICE_BOTTOM#, FILL YES
  lx# = BLUE_RIGHT_X# - camX#
  DRAWBOX X1 (lx# - LINE_HALF#), Y1 ICE_TOP#, X2 (lx# + LINE_HALF#), Y2 ICE_BOTTOM#, FILL YES

  ' Center circle and dot
  SETCOLOR RED&
  cx# = CENTER_X# - camX#
  cy# = 240
  DRAWCIRCLE X cx#, Y cy#, RADIUS 60, FILL NO
  DRAWCIRCLE X cx#, Y cy#, RADIUS 3, FILL YES

  ' Faceoff circles and dots (4 zone dots)
  DRAWCIRCLE X (200 - camX#), Y 150, RADIUS 60, FILL NO
  DRAWCIRCLE X (200 - camX#), Y 330, RADIUS 60, FILL NO
  DRAWCIRCLE X (1000 - camX#), Y 150, RADIUS 60, FILL NO
  DRAWCIRCLE X (1000 - camX#), Y 330, RADIUS 60, FILL NO
  DRAWCIRCLE X (200 - camX#), Y 150, RADIUS 3, FILL YES
  DRAWCIRCLE X (200 - camX#), Y 330, RADIUS 3, FILL YES
  DRAWCIRCLE X (1000 - camX#), Y 150, RADIUS 3, FILL YES
  DRAWCIRCLE X (1000 - camX#), Y 330, RADIUS 3, FILL YES

  ' Goal creases (filled light blue semicircles)
  ' Left crease: filled circle + white box to mask left half
  SETCOLOR CREASE_COLOR&
  DRAWCIRCLE X (GOAL_LEFT_X# - camX#), Y 240, RADIUS 25, FILL YES
  SETCOLOR WHITE&
  DRAWBOX X1 (GOAL_LEFT_X# - 26 - camX#), Y1 214, X2 (GOAL_LEFT_X# - camX#), Y2 266, FILL YES
  ' Right crease: filled circle + white box to mask right half
  SETCOLOR CREASE_COLOR&
  DRAWCIRCLE X (GOAL_RIGHT_X# - camX#), Y 240, RADIUS 25, FILL YES
  SETCOLOR WHITE&
  DRAWBOX X1 (GOAL_RIGHT_X# - camX#), Y1 214, X2 (GOAL_RIGHT_X# + 26 - camX#), Y2 266, FILL YES

  ' Goal nets
  SETCOLOR RED&
  DRAWBOX X1 (GOAL_LEFT_X# - GOAL_W# - camX#), Y1 (240 - GOAL_H# / 2), X2 (GOAL_LEFT_X# - camX#), Y2 (240 + GOAL_H# / 2), FILL NO
  DRAWBOX X1 (GOAL_RIGHT_X# - camX#), Y1 (240 - GOAL_H# / 2), X2 (GOAL_RIGHT_X# + GOAL_W# - camX#), Y2 (240 + GOAL_H# / 2), FILL NO
END FUNCTION

FUNCTION updateAnimations
  FOR i# FROM 1 TO 8
    pAnimTimer@[i#] = pAnimTimer@[i#] + 1
    anim# = pAnim@[i#]

    IF anim# = ANIM_SKATE# THEN
      IF pPushing@[i#] = 1 THEN
        IF pAnimTimer@[i#] >= SKATE_FRAME_TIME# THEN
          pAnimTimer@[i#] = 0
          pAnimFrame@[i#] = pAnimFrame@[i#] + 1
          IF pAnimFrame@[i#] > 3 THEN
            pAnimFrame@[i#] = 1
          END IF
        END IF
      ELSE
        pAnimFrame@[i#] = 2
        pAnimTimer@[i#] = 0
      END IF
    ELSE IF anim# = ANIM_SHOOT# THEN
      IF pAnimTimer@[i#] >= SHOOT_FRAME_TIME# THEN
        pAnimTimer@[i#] = 0
        pAnimFrame@[i#] = pAnimFrame@[i#] + 1
        IF pAnimFrame@[i#] > 3 THEN
          pAnimFrame@[i#] = 1
          pAnim@[i#] = ANIM_SKATE#
        END IF
      END IF
    ELSE IF anim# = ANIM_GOALIE_GLOVE# OR anim# = ANIM_GOALIE_BLOCKER# OR anim# = ANIM_GOALIE_SPLIT# THEN
      IF pAnimTimer@[i#] >= GOALIE_FRAME_TIME# THEN
        pAnimTimer@[i#] = 0
        pAnimFrame@[i#] = pAnimFrame@[i#] + 1
        IF pAnimFrame@[i#] > 2 THEN
          pAnimFrame@[i#] = 1
          pAnim@[i#] = ANIM_GOALIE_IDLE#
        END IF
      END IF
    END IF
  END FOR
END FUNCTION

FUNCTION getPlayerSprite# IDX idx#
  anim# = pAnim@[idx#]
  frame# = pAnimFrame@[idx#]
  isWhalers? = (idx# <= 4)

  IF anim# = ANIM_SKATE# THEN
    IF isWhalers? THEN
      result# = wSkate@[frame#]
    ELSE
      result# = oSkate@[frame#]
    END IF
  ELSE IF anim# = ANIM_SHOOT# THEN
    IF isWhalers? THEN
      result# = wShoot@[frame#]
    ELSE
      result# = oShoot@[frame#]
    END IF
  ELSE IF anim# = ANIM_GOALIE_IDLE# THEN
    IF isWhalers? THEN
      result# = wGoalieId#
    ELSE
      result# = oGoalieId#
    END IF
  ELSE IF anim# = ANIM_GOALIE_GLOVE# THEN
    IF isWhalers? THEN
      result# = wGoalieGlove@[frame#]
    ELSE
      result# = oGoalieGlove@[frame#]
    END IF
  ELSE IF anim# = ANIM_GOALIE_BLOCKER# THEN
    IF isWhalers? THEN
      result# = wGoalieBlocker@[frame#]
    ELSE
      result# = oGoalieBlocker@[frame#]
    END IF
  ELSE IF anim# = ANIM_GOALIE_SPLIT# THEN
    IF isWhalers? THEN
      result# = wGoalieSplit@[frame#]
    ELSE
      result# = oGoalieSplit@[frame#]
    END IF
  END IF

  RETURN result#
END FUNCTION

FUNCTION drawPlayers
  ' Sort by Y for depth (bubble sort, only 8 elements)
  sortOrder@ = [1, 2, 3, 4, 5, 6, 7, 8]
  FOR i# FROM 1 TO 7
    FOR j# FROM 1 TO 8 - i#
      IF pY@[sortOrder@[j#]] > pY@[sortOrder@[j# + 1]] THEN
        temp# = sortOrder@[j#]
        sortOrder@[j#] = sortOrder@[j# + 1]
        sortOrder@[j# + 1] = temp#
      END IF
    END FOR
  END FOR

  FOR i# FROM 1 TO 8
    idx# = sortOrder@[i#]
    sx# = pX@[idx#] - camX#
    sy# = pY@[idx#]

    ' Skip if off screen
    IF sx# < -30 OR sx# > 670 THEN
      CONTINUE
    END IF

    ' Pick sprite based on team, position, and animation state
    sprId# = getPlayerSprite# IDX idx#

    ' Flip if facing left
    flip? = NO
    IF pDir@[idx#] = -1 THEN
      flip? = YES
    END IF

    ' Active player indicator
    IF idx# = activeP# THEN
      sprW# = SPRITEWIDTH# SPRITE sprId#
      SETCOLOR INDICATOR_COLOR&
      DRAWCIRCLE X (sx# + sprW# * PLAYER_SCALE# / 2), Y (sy# + 17 * PLAYER_SCALE#), RADIUS 18, FILL YES
    END IF

    ' Draw player
    DRAWSPRITE SPRITE sprId#, X sx#, Y sy#, SCALE PLAYER_SCALE#, FLIPH flip?

    ' Draw stick (skaters only, not goalies)
    IF idx# <> 4 AND idx# <> 8 THEN
      SETCOLOR BROWN&
      IF pDir@[idx#] = 1 THEN
        shX# = sx# + 11 * PLAYER_SCALE#
        shY# = sy# + 10 * PLAYER_SCALE#
        stX# = sx# + 14 * PLAYER_SCALE#
        stY# = sy# + 13 * PLAYER_SCALE#
      ELSE
        shX# = sx# + 5 * PLAYER_SCALE#
        shY# = sy# + 10 * PLAYER_SCALE#
        stX# = sx# - 2 * PLAYER_SCALE#
        stY# = sy# + 13 * PLAYER_SCALE#
      END IF
      DRAWLINE X1 shX#, Y1 shY#, X2 stX#, Y2 stY#
      IF pDir@[idx#] = 1 THEN
        DRAWLINE X1 stX#, Y1 stY#, X2 (stX# + 2 * PLAYER_SCALE#), Y2 stY#
      ELSE
        DRAWLINE X1 stX#, Y1 stY#, X2 (stX# - 2 * PLAYER_SCALE#), Y2 stY#
      END IF
    END IF
  END FOR
END FUNCTION

FUNCTION drawPuck
  sx# = puckX# - camX#
  IF sx# > -10 AND sx# < 650 THEN
    DRAWSPRITE SPRITE puckSprId#, X sx#, Y puckY#, SCALE PUCK_SCALE#
  END IF
END FUNCTION

FUNCTION drawScore
  ' Display score at top of screen
  SETCOLOR WHITE&
  PRINTAT 1, 30, "WHR"
  PRINTAT 1, 34, scoreW#
  PRINTAT 1, 36, "-"
  PRINTAT 1, 38, scoreO#
  PRINTAT 1, 40, "OPP"
END FUNCTION

FUNCTION handleInput
  keys@ = GETALLKEYS@
  inputX# = 0
  inputY# = 0
  inputShoot? = NO
  inputPass? = NO
  FOR ki# FROM 1 TO LENGTH# keys@
    k$ = keys@[ki#]
    IF k$ = "ArrowLeft" THEN
      inputX# = -1
    END IF
    IF k$ = "ArrowRight" THEN
      inputX# = 1
    END IF
    IF k$ = "ArrowUp" THEN
      inputY# = -1
    END IF
    IF k$ = "ArrowDown" THEN
      inputY# = 1
    END IF
    IF k$ = "z" OR k$ = "Z" THEN
      inputShoot? = YES
    END IF
    IF k$ = "x" OR k$ = "X" THEN
      inputPass? = YES
    END IF
  END FOR

  ' Edge detect pass button (fire once per press)
  passPressed? = NO
  IF inputPass? AND NOT prevPass? THEN
    passPressed? = YES
  END IF
  prevPass? = inputPass?
END FUNCTION

FUNCTION moveActivePlayer
  IF pState@[activeP#] = 2 THEN
    RETURN
  END IF

  rIdx# = pRoster@[activeP#]
  spd# = wSpeed@[rIdx#] * 0.4 + 2

  IF inputX# <> 0 OR inputY# <> 0 THEN
    pPushing@[activeP#] = 1

    ' Normalize diagonal
    IF inputX# <> 0 AND inputY# <> 0 THEN
      spd# = spd# * 0.707
    END IF
    pVX@[activeP#] = pVX@[activeP#] + inputX# * spd# * 0.3
    pVY@[activeP#] = pVY@[activeP#] + inputY# * spd# * 0.3

    ' Update facing direction
    IF inputX# <> 0 THEN
      pDir@[activeP#] = inputX#
    END IF
  ELSE
    pPushing@[activeP#] = 0
  END IF
END FUNCTION

FUNCTION updatePlayerPhysics
  FOR i# FROM 1 TO NUM_PLAYERS#
    ' Apply friction
    pVX@[i#] = pVX@[i#] * PLAYER_FRICTION#
    pVY@[i#] = pVY@[i#] * PLAYER_FRICTION#

    ' Clamp small velocities to zero
    IF ABS# VALUE pVX@[i#] < 0.1 THEN
      pVX@[i#] = 0
    END IF
    IF ABS# VALUE pVY@[i#] < 0.1 THEN
      pVY@[i#] = 0
    END IF

    ' Update position
    pX@[i#] = pX@[i#] + pVX@[i#]
    pY@[i#] = pY@[i#] + pVY@[i#]

    ' Clamp to ice bounds (goalies handled separately)
    IF i# = 4 OR i# = 8 THEN
      ' Goalie bounds — skip for now
    ELSE
      pX@[i#] = MAX# A pX@[i#], B ICE_LEFT#
      pX@[i#] = MIN# A pX@[i#], B (ICE_RIGHT# - 24)
      pY@[i#] = MAX# A pY@[i#], B ICE_TOP#
      pY@[i#] = MIN# A pY@[i#], B (ICE_BOTTOM# - 32)
    END IF

    ' Board bounce
    IF pX@[i#] <= ICE_LEFT# OR pX@[i#] >= (ICE_RIGHT# - 24) THEN
      pVX@[i#] = pVX@[i#] * -0.3
    END IF
    IF pY@[i#] <= ICE_TOP# OR pY@[i#] >= (ICE_BOTTOM# - 32) THEN
      pVY@[i#] = pVY@[i#] * -0.3
    END IF

    ' Update stun timer
    IF pState@[i#] = 2 THEN
      IF now# - pStateT@[i#] > 800 THEN
        pState@[i#] = 0
      END IF
    END IF
  END FOR
END FUNCTION

FUNCTION switchActivePlayer
  ' Only switch if no Whaler has puck (X = pass when Whaler has puck)
  IF puckOwner# >= 1 AND puckOwner# <= 3 THEN
    RETURN
  END IF

  bestDist# = 99999
  bestP# = activeP#

  FOR i# FROM 1 TO 3
    IF pState@[i#] = 2 THEN
      CONTINUE
    END IF
    dx# = pX@[i#] - puckX#
    dy# = pY@[i#] - puckY#
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)
    IF dist# < bestDist# THEN
      bestDist# = dist#
      bestP# = i#
    END IF
  END FOR

  activeP# = bestP#
END FUNCTION

FUNCTION updateTeammateAI
  FOR i# FROM 1 TO 3
    IF i# = activeP# THEN
      CONTINUE
    END IF
    IF pState@[i#] = 2 THEN
      CONTINUE
    END IF

    rIdx# = pRoster@[i#]
    spd# = wSpeed@[rIdx#] * 0.3 + 1.5

    IF puckX# < CENTER_X# THEN
      ' Puck in our zone — defensive positioning
      IF i# = 1 THEN
        targetX# = puckX# + 80
        targetY# = 180
      ELSE IF i# = 2 THEN
        targetX# = puckX# + 60
        targetY# = 300
      ELSE
        targetX# = puckX# + 120
        targetY# = 240
      END IF
    ELSE
      ' Puck in their zone — offensive positioning
      IF i# = 1 THEN
        targetX# = puckX# + 50
        targetY# = 160
      ELSE IF i# = 2 THEN
        targetX# = puckX# + 50
        targetY# = 320
      ELSE
        targetX# = puckX# - 60
        targetY# = 240
      END IF
    END IF

    ' Clamp targets to ice
    targetX# = MAX# A targetX#, B (ICE_LEFT# + 30)
    targetY# = MAX# A targetY#, B (ICE_TOP# + 20)
    targetX# = MIN# A targetX#, B (ICE_RIGHT# - 50)
    targetY# = MIN# A targetY#, B (ICE_BOTTOM# - 50)

    ' Move toward target
    dx# = targetX# - pX@[i#]
    dy# = targetY# - pY@[i#]
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)

    IF dist# > 10 THEN
      pPushing@[i#] = 1
      pVX@[i#] = pVX@[i#] + (dx# / dist#) * spd# * 0.2
      pVY@[i#] = pVY@[i#] + (dy# / dist#) * spd# * 0.2
    ELSE
      pPushing@[i#] = 0
    END IF

    ' Update facing
    IF dx# > 5 THEN
      pDir@[i#] = 1
    ELSE IF dx# < -5 THEN
      pDir@[i#] = -1
    END IF
  END FOR
END FUNCTION

FUNCTION updateOpponentAI
  FOR i# FROM 5 TO 7
    IF pState@[i#] = 2 THEN
      CONTINUE
    END IF

    rIdx# = pRoster@[i#]
    spd# = oSpeed@[rIdx#] * 0.3 + 1.5

    IF puckOwner# = i# THEN
      ' This opponent has the puck — skate toward Whalers' goal and shoot
      targetX# = GOAL_LEFT_X# + 80
      targetY# = 240

      ' If close enough to goal, shoot
      shotDx# = pX@[i#] - GOAL_LEFT_X#
      IF ABS# VALUE shotDx# < 200 THEN
        ' Shoot toward left goal
        sdx# = GOAL_LEFT_X# - puckX#
        sdy# = 240 - puckY#
        sDist# = SQRT# VALUE (sdx# * sdx# + sdy# * sdy#)
        oPower# = SHOT_POWER_MIN# + (SHOT_POWER_MAX# - SHOT_POWER_MIN#) * 0.7
        rIdx2# = pRoster@[i#]
        oPower# = oPower# * (0.7 + oShot@[rIdx2#] * 0.03)
        IF sDist# > 0 THEN
          puckVX# = (sdx# / sDist#) * oPower#
          puckVY# = (sdy# / sDist#) * oPower#
        ELSE
          puckVX# = 0 - oPower#
          puckVY# = 0
        END IF
        pHasPuck@[i#] = 0
        puckOwner# = 0
        puckLoose? = YES
        puckFreezeUntil# = now# + 200
        pAnim@[i#] = ANIM_SHOOT#
        pAnimFrame@[i#] = 1
        pAnimTimer@[i#] = 0
      END IF
    ELSE IF puckOwner# >= 5 AND puckOwner# <= 7 THEN
      ' Teammate has puck — get open on offense
      IF i# = 5 THEN
        targetX# = pX@[puckOwner#] - 80
        targetY# = 180
      ELSE IF i# = 6 THEN
        targetX# = pX@[puckOwner#] - 60
        targetY# = 300
      ELSE
        targetX# = pX@[puckOwner#] - 120
        targetY# = 240
      END IF
    ELSE
      ' Puck is loose or Whalers have it — chase/defend
      IF puckLoose? THEN
        targetX# = puckX#
        targetY# = puckY#
      ELSE
        ' Chase puck carrier
        targetX# = pX@[puckOwner#]
        targetY# = pY@[puckOwner#]
      END IF

      ' Not all opponents chase — closest one chases, others hold lanes
      ' Find closest opponent to puck
      closestOpp# = 5
      closestDist# = 99999
      FOR ci# FROM 5 TO 7
        cdx# = pX@[ci#] - puckX#
        cdy# = pY@[ci#] - puckY#
        cd# = SQRT# VALUE (cdx# * cdx# + cdy# * cdy#)
        IF cd# < closestDist# THEN
          closestDist# = cd#
          closestOpp# = ci#
        END IF
      END FOR

      IF i# <> closestOpp# THEN
        ' Hold defensive position instead
        IF i# = 5 THEN
          targetX# = 700
          targetY# = 240
        ELSE IF i# = 6 THEN
          targetX# = 800
          targetY# = 160
        ELSE
          targetX# = 800
          targetY# = 320
        END IF
      END IF
    END IF

    ' Move toward target
    dx# = targetX# - pX@[i#]
    dy# = targetY# - pY@[i#]
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)

    IF dist# > 10 THEN
      pPushing@[i#] = 1
      pVX@[i#] = pVX@[i#] + (dx# / dist#) * spd# * 0.2
      pVY@[i#] = pVY@[i#] + (dy# / dist#) * spd# * 0.2
    ELSE
      pPushing@[i#] = 0
    END IF

    ' Update facing
    IF dx# > 5 THEN
      pDir@[i#] = 1
    ELSE IF dx# < -5 THEN
      pDir@[i#] = -1
    END IF
  END FOR
END FUNCTION

FUNCTION updatePuck
  IF puckOwner# > 0 THEN
    ' Puck attached to carrier (on stick blade)
    offX# = 14
    IF pDir@[puckOwner#] = -1 THEN
      offX# = -2
    END IF
    puckX# = pX@[puckOwner#] + offX# * PLAYER_SCALE#
    puckY# = pY@[puckOwner#] + 13 * PLAYER_SCALE#
    puckVX# = 0
    puckVY# = 0
    RETURN
  END IF

  ' Apply friction
  puckVX# = puckVX# * PUCK_FRICTION#
  puckVY# = puckVY# * PUCK_FRICTION#

  ' Clamp tiny velocities
  IF ABS# VALUE puckVX# < 0.05 THEN
    puckVX# = 0
  END IF
  IF ABS# VALUE puckVY# < 0.05 THEN
    puckVY# = 0
  END IF

  ' Update position
  puckX# = puckX# + puckVX#
  puckY# = puckY# + puckVY#

  ' Board collision (top/bottom bounce)
  IF puckY# < ICE_TOP# THEN
    puckY# = ICE_TOP#
    puckVY# = ABS# VALUE puckVY# * 0.7
  END IF
  IF puckY# > ICE_BOTTOM# - 8 THEN
    puckY# = ICE_BOTTOM# - 8
    puckVY# = 0 - ABS# VALUE puckVY# * 0.7
  END IF

  ' Left/right boards (but not in goal mouth)
  IF puckX# < ICE_LEFT# THEN
    IF puckY# > 240 - GOAL_H# / 2 AND puckY# < 240 + GOAL_H# / 2 THEN
      ' Into left goal area — let checkGoals handle it
    ELSE
      puckX# = ICE_LEFT#
      puckVX# = ABS# VALUE puckVX# * 0.7
    END IF
  END IF
  IF puckX# > ICE_RIGHT# - 8 THEN
    IF puckY# > 240 - GOAL_H# / 2 AND puckY# < 240 + GOAL_H# / 2 THEN
      ' Into right goal area — let checkGoals handle it
    ELSE
      puckX# = ICE_RIGHT# - 8
      puckVX# = 0 - ABS# VALUE puckVX# * 0.7
    END IF
  END IF

  ' Pickup detection (if not frozen)
  IF now# > puckFreezeUntil# THEN
    FOR i# FROM 1 TO NUM_PLAYERS#
      IF pState@[i#] = 2 THEN
        CONTINUE
      END IF
      dx# = pX@[i#] + 8 * PLAYER_SCALE# - puckX#
      dy# = pY@[i#] + 10 * PLAYER_SCALE# - puckY#
      dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)
      IF dist# < 20 THEN
        ' One-timer check: Whaler picking up a pass while Z held
        IF passInFlight? AND now# - passTime# < 500 THEN
          IF i# >= 1 AND i# <= 3 AND i# <> activeP# AND inputShoot? THEN
            ' ONE-TIMER! Auto-shoot with bonus power
            otPower# = SHOT_POWER_MAX# * 1.3
            gdx# = GOAL_RIGHT_X# - puckX#
            gdy# = 240 - puckY#
            gDist# = SQRT# VALUE (gdx# * gdx# + gdy# * gdy#)
            IF gDist# > 0 THEN
              puckVX# = (gdx# / gDist#) * otPower#
              puckVY# = (gdy# / gDist#) * otPower#
            ELSE
              puckVX# = otPower#
              puckVY# = 0
            END IF
            puckOwner# = 0
            puckLoose? = YES
            puckFreezeUntil# = now# + 200
            passInFlight? = NO
            activeP# = i#
            RETURN
          END IF
        END IF

        puckOwner# = i#
        puckLoose? = NO
        pHasPuck@[i#] = 1
        passInFlight? = NO
        ' Auto-switch to Whaler who picks up puck
        IF i# >= 1 AND i# <= 3 THEN
          activeP# = i#
        END IF
        BREAK
      END IF
    END FOR
  END IF
END FUNCTION

FUNCTION handleShooting
  ap# = activeP#

  ' Only the active player shoots via human input
  IF puckOwner# <> ap# THEN
    shotCharging? = NO
    RETURN
  END IF

  IF inputShoot? THEN
    IF NOT shotCharging? THEN
      ' Start charging
      shotCharging? = YES
      shotChargeStart# = now#
    END IF
  ELSE
    IF shotCharging? THEN
      ' Release shot!
      chargeMs# = now# - shotChargeStart#
      chargePct# = MIN# A (chargeMs# / SHOT_CHARGE_TIME#), B 1.0

      rIdx# = pRoster@[ap#]
      shotStat# = wShot@[rIdx#]
      power# = SHOT_POWER_MIN# + chargePct# * (SHOT_POWER_MAX# - SHOT_POWER_MIN#)
      power# = power# * (0.7 + shotStat# * 0.03)

      ' Shot direction: toward opponent goal
      goalY# = 240
      dx# = GOAL_RIGHT_X# - puckX#
      dy# = goalY# - puckY#
      dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)

      IF dist# > 0 THEN
        puckVX# = (dx# / dist#) * power#
        puckVY# = (dy# / dist#) * power#
      ELSE
        puckVX# = power#
        puckVY# = 0
      END IF

      ' Release puck
      pHasPuck@[ap#] = 0
      puckOwner# = 0
      puckLoose? = YES
      puckFreezeUntil# = now# + 200

      ' Trigger shoot animation
      pAnim@[ap#] = ANIM_SHOOT#
      pAnimFrame@[ap#] = 1
      pAnimTimer@[ap#] = 0

      shotCharging? = NO
    END IF
  END IF
END FUNCTION

FUNCTION handlePassing
  ap# = activeP#

  IF NOT passPressed? THEN
    RETURN
  END IF
  IF puckOwner# <> ap# THEN
    ' No puck — switch player instead
    switchActivePlayer
    RETURN
  END IF

  ' Determine input direction (default to facing)
  dirX# = inputX#
  dirY# = inputY#
  IF dirX# = 0 AND dirY# = 0 THEN
    dirX# = pDir@[ap#]
  END IF

  ' Find teammate most aligned with input direction
  ' Use dot product between input direction and direction-to-teammate
  bestDot# = -99999
  bestTarget# = 0
  FOR ti# FROM 1 TO 3
    IF ti# = ap# THEN
      CONTINUE
    END IF
    IF pState@[ti#] = 2 THEN
      CONTINUE
    END IF
    ' Direction from passer to teammate
    tdx# = pX@[ti#] - pX@[ap#]
    tdy# = pY@[ti#] - pY@[ap#]
    tDist# = SQRT# VALUE (tdx# * tdx# + tdy# * tdy#)
    IF tDist# < 10 THEN
      CONTINUE
    END IF
    tdx# = tdx# / tDist#
    tdy# = tdy# / tDist#
    ' Dot product with input direction
    dot# = tdx# * dirX# + tdy# * dirY#
    IF dot# > bestDot# THEN
      bestDot# = dot#
      bestTarget# = ti#
    END IF
  END FOR

  ' Aim pass at the target teammate (or fallback to raw direction)
  IF bestTarget# > 0 THEN
    passDX# = pX@[bestTarget#] - puckX#
    passDY# = pY@[bestTarget#] - puckY#
    pDist# = SQRT# VALUE (passDX# * passDX# + passDY# * passDY#)
    IF pDist# > 0 THEN
      passDX# = passDX# / pDist#
      passDY# = passDY# / pDist#
    END IF
  ELSE
    ' No valid target — pass in raw input direction
    pDist# = SQRT# VALUE (dirX# * dirX# + dirY# * dirY#)
    IF pDist# > 0 THEN
      passDX# = dirX# / pDist#
      passDY# = dirY# / pDist#
    ELSE
      passDX# = pDir@[ap#]
      passDY# = 0
    END IF
  END IF

  ' Release puck
  puckVX# = passDX# * PASS_SPEED#
  puckVY# = passDY# * PASS_SPEED#
  pHasPuck@[ap#] = 0
  puckOwner# = 0
  puckLoose? = YES
  puckFreezeUntil# = now# + 150

  passInFlight? = YES
  passTime# = now#
END FUNCTION

FUNCTION checkGoals
  ' Whalers defend LEFT goal, opponent defends RIGHT

  ' Check right goal (opponent's goal — Whalers score)
  IF puckX# > GOAL_RIGHT_X# + GOAL_W# THEN
    IF puckY# > 240 - GOAL_H# / 2 AND puckY# < 240 + GOAL_H# / 2 THEN
      scoreW# = scoreW# + 1
      ' Reset puck to center
      puckOwner# = 0
      puckLoose? = YES
      puckX# = 600
      puckY# = 240
      puckVX# = 0
      puckVY# = 0
      shotCharging? = NO
      passInFlight? = NO
    END IF
  END IF

  ' Check left goal (Whalers' goal — opponent scores)
  IF puckX# < GOAL_LEFT_X# - GOAL_W# THEN
    IF puckY# > 240 - GOAL_H# / 2 AND puckY# < 240 + GOAL_H# / 2 THEN
      scoreO# = scoreO# + 1
      ' Reset puck to center
      puckOwner# = 0
      puckLoose? = YES
      puckX# = 600
      puckY# = 240
      puckVX# = 0
      puckVY# = 0
      shotCharging? = NO
      passInFlight? = NO
    END IF
  END IF
END FUNCTION

' ============ MAIN LOOP ============
BUFFERENABLED YES
running? = YES

WHILE running?
  now# = RUNNINGTIME#

  ' Input
  handleInput

  ' Shooting and passing (before movement so puck release happens this frame)
  handleShooting
  handlePassing

  ' Movement
  moveActivePlayer
  updateTeammateAI
  updateOpponentAI
  updatePlayerPhysics

  ' Puck physics and goals
  updatePuck
  checkGoals

  ' Animation and camera
  updateAnimations
  updateCamera

  ' Draw
  CLEARBUFFER
  drawRink
  drawPlayers
  drawPuck
  drawScore

  SHOWBUFFER
  SLEEP 0.016
END WHILE
