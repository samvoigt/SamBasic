periodEndStart# = 0
faceoffWait# = 0

' Faceoff dot locations
faceDotX@ = [600, 200, 200, 1000, 1000]
faceDotY@ = [240, 150, 330, 150, 330]
faceoffDot# = 1

' Fight state
fightP1# = 0
fightP2# = 0
fightStart# = 0
fightHP1# = 0
fightHP2# = 0
fightCooldown1# = 0
fightCooldown2# = 0
fightWinner# = 0
fightHitTimer1# = 0
fightHitTimer2# = 0
fightPunchTimer1# = 0
fightPunchTimer2# = 0
