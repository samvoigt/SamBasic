' ============ FUNCTIONS ============

FUNCTION updateCamera
  ' Target: center active player horizontally on screen
  targetCamX# = pX@[activeP#] - SCREEN_W# / 2

  ' Clamp to rink bounds
  targetCamX# = MAX# A targetCamX#, B 0
  targetCamX# = MIN# A targetCamX#, B (RINK_W# - SCREEN_W#)

  ' Smooth follow (lerp)
  camX# = camX# + (targetCamX# - camX#) * 0.08
END FUNCTION

FUNCTION collidePuck
  ' Straight wall clamping
  puckX# = MAX# A puckX#, B ICE_LEFT#
  puckX# = MIN# A puckX#, B ICE_RIGHT#
  puckY# = MAX# A puckY#, B ICE_TOP#
  puckY# = MIN# A puckY#, B ICE_BOTTOM#

  ' Corner circle centers
  cLeftX# = ICE_LEFT# + ICE_CORNER_R#
  cRightX# = ICE_RIGHT# - ICE_CORNER_R#
  cTopY# = ICE_TOP# + ICE_CORNER_R#
  cBotY# = ICE_BOTTOM# - ICE_CORNER_R#

  ' Corner radius squared for quick check
  cR2# = ICE_CORNER_R# * ICE_CORNER_R#

  ' Top-left corner
  IF puckX# < cLeftX# AND puckY# < cTopY# THEN
    dx# = puckX# - cLeftX#
    dy# = puckY# - cTopY#
    d2# = dx# * dx# + dy# * dy#
    IF d2# > cR2# THEN
      dist# = SQRT# VALUE d2#
      puckX# = cLeftX# + dx# / dist# * ICE_CORNER_R#
      puckY# = cTopY# + dy# / dist# * ICE_CORNER_R#
    END IF
  END IF

  ' Top-right corner
  IF puckX# > cRightX# AND puckY# < cTopY# THEN
    dx# = puckX# - cRightX#
    dy# = puckY# - cTopY#
    d2# = dx# * dx# + dy# * dy#
    IF d2# > cR2# THEN
      dist# = SQRT# VALUE d2#
      puckX# = cRightX# + dx# / dist# * ICE_CORNER_R#
      puckY# = cTopY# + dy# / dist# * ICE_CORNER_R#
    END IF
  END IF

  ' Bottom-left corner
  IF puckX# < cLeftX# AND puckY# > cBotY# THEN
    dx# = puckX# - cLeftX#
    dy# = puckY# - cBotY#
    d2# = dx# * dx# + dy# * dy#
    IF d2# > cR2# THEN
      dist# = SQRT# VALUE d2#
      puckX# = cLeftX# + dx# / dist# * ICE_CORNER_R#
      puckY# = cBotY# + dy# / dist# * ICE_CORNER_R#
    END IF
  END IF

  ' Bottom-right corner
  IF puckX# > cRightX# AND puckY# > cBotY# THEN
    dx# = puckX# - cRightX#
    dy# = puckY# - cBotY#
    d2# = dx# * dx# + dy# * dy#
    IF d2# > cR2# THEN
      dist# = SQRT# VALUE d2#
      puckX# = cRightX# + dx# / dist# * ICE_CORNER_R#
      puckY# = cBotY# + dy# / dist# * ICE_CORNER_R#
    END IF
  END IF
END FUNCTION

FUNCTION drawRink
  ' Screen bounds for culling
  scrL# = camX# - 80
  scrR# = camX# + SCREEN_W# + 80

  ' Boards (dark gray rounded rectangle)
  SETCOLOR DARKGRAY&
  bx1# = 0 - camX#
  bx2# = RINK_W# - camX#
  by1# = RINK_TOP#
  by2# = RINK_TOP# + RINK_H#
  DRAWBOX X1 (bx1# + CORNER_R#), Y1 by1#, X2 (bx2# - CORNER_R#), Y2 by2#, FILL YES
  DRAWBOX X1 bx1#, Y1 (by1# + CORNER_R#), X2 bx2#, Y2 (by2# - CORNER_R#), FILL YES
  IF CORNER_R# < scrR# THEN
    DRAWCIRCLE X (bx1# + CORNER_R#), Y (by1# + CORNER_R#), RADIUS CORNER_R#, FILL YES
    DRAWCIRCLE X (bx1# + CORNER_R#), Y (by2# - CORNER_R#), RADIUS CORNER_R#, FILL YES
  END IF
  IF RINK_W# - CORNER_R# > scrL# THEN
    DRAWCIRCLE X (bx2# - CORNER_R#), Y (by1# + CORNER_R#), RADIUS CORNER_R#, FILL YES
    DRAWCIRCLE X (bx2# - CORNER_R#), Y (by2# - CORNER_R#), RADIUS CORNER_R#, FILL YES
  END IF

  ' Player benches (top side, between blue lines)
  IF BENCH_LEFT_X2# > scrL# AND BENCH_LEFT_X1# < scrR# THEN
    SETCOLOR BENCH_COLOR&
    DRAWBOX X1 (BENCH_LEFT_X1# - camX#), Y1 BENCH_Y1#, X2 (BENCH_LEFT_X2# - camX#), Y2 BENCH_Y2#, FILL YES
    SETCOLOR BENCH_SEAT_COLOR&
    DRAWBOX X1 (BENCH_LEFT_X1# + 3 - camX#), Y1 (BENCH_Y1# + 3), X2 (BENCH_LEFT_X2# - 3 - camX#), Y2 (BENCH_Y2# - 3), FILL YES
  END IF
  IF BENCH_RIGHT_X2# > scrL# AND BENCH_RIGHT_X1# < scrR# THEN
    SETCOLOR BENCH_COLOR&
    DRAWBOX X1 (BENCH_RIGHT_X1# - camX#), Y1 BENCH_Y1#, X2 (BENCH_RIGHT_X2# - camX#), Y2 BENCH_Y2#, FILL YES
    SETCOLOR BENCH_SEAT_COLOR&
    DRAWBOX X1 (BENCH_RIGHT_X1# + 3 - camX#), Y1 (BENCH_Y1# + 3), X2 (BENCH_RIGHT_X2# - 3 - camX#), Y2 (BENCH_Y2# - 3), FILL YES
  END IF

  ' Bench players (drawn before ice so boards cover their lower half)
  benchY# = 24
  FOR bp# FROM 0 TO 4
    bpx# = 459 + bp# * 26
    IF bpx# > scrL# AND bpx# < scrR# THEN
      DRAWSPRITE SPRITE wSkate@[2], X (bpx# - camX#), Y benchY#, SCALE 2
    END IF
    bpx# = 609 + bp# * 26
    IF bpx# > scrL# AND bpx# < scrR# THEN
      DRAWSPRITE SPRITE oSkate@[2], X (bpx# - camX#), Y benchY#, SCALE 2
    END IF
  END FOR

  ' Ice surface (white rounded rectangle)
  SETCOLOR WHITE&
  ix1# = ICE_LEFT# - camX#
  ix2# = ICE_RIGHT# - camX#
  iy1# = ICE_TOP#
  iy2# = ICE_BOTTOM#
  DRAWBOX X1 (ix1# + ICE_CORNER_R#), Y1 iy1#, X2 (ix2# - ICE_CORNER_R#), Y2 iy2#, FILL YES
  DRAWBOX X1 ix1#, Y1 (iy1# + ICE_CORNER_R#), X2 ix2#, Y2 (iy2# - ICE_CORNER_R#), FILL YES
  IF ICE_LEFT# + ICE_CORNER_R# < scrR# THEN
    DRAWCIRCLE X (ix1# + ICE_CORNER_R#), Y (iy1# + ICE_CORNER_R#), RADIUS ICE_CORNER_R#, FILL YES
    DRAWCIRCLE X (ix1# + ICE_CORNER_R#), Y (iy2# - ICE_CORNER_R#), RADIUS ICE_CORNER_R#, FILL YES
  END IF
  IF ICE_RIGHT# - ICE_CORNER_R# > scrL# THEN
    DRAWCIRCLE X (ix2# - ICE_CORNER_R#), Y (iy1# + ICE_CORNER_R#), RADIUS ICE_CORNER_R#, FILL YES
    DRAWCIRCLE X (ix2# - ICE_CORNER_R#), Y (iy2# - ICE_CORNER_R#), RADIUS ICE_CORNER_R#, FILL YES
  END IF

  ' Goal lines (thin red)
  SETCOLOR RED&
  IF GOAL_LEFT_X# > scrL# AND GOAL_LEFT_X# < scrR# THEN
    DRAWLINE X1 (GOAL_LEFT_X# - camX#), Y1 ICE_TOP#, X2 (GOAL_LEFT_X# - camX#), Y2 ICE_BOTTOM#
  END IF
  IF GOAL_RIGHT_X# > scrL# AND GOAL_RIGHT_X# < scrR# THEN
    DRAWLINE X1 (GOAL_RIGHT_X# - camX#), Y1 ICE_TOP#, X2 (GOAL_RIGHT_X# - camX#), Y2 ICE_BOTTOM#
  END IF

  ' Center red line
  IF CENTER_X# > scrL# AND CENTER_X# < scrR# THEN
    lx# = CENTER_X# - camX#
    DRAWBOX X1 (lx# - LINE_HALF#), Y1 ICE_TOP#, X2 (lx# + LINE_HALF#), Y2 ICE_BOTTOM#, FILL YES
  END IF

  ' Blue lines
  SETCOLOR BLUE&
  IF BLUE_LEFT_X# > scrL# AND BLUE_LEFT_X# < scrR# THEN
    lx# = BLUE_LEFT_X# - camX#
    DRAWBOX X1 (lx# - LINE_HALF#), Y1 ICE_TOP#, X2 (lx# + LINE_HALF#), Y2 ICE_BOTTOM#, FILL YES
  END IF
  IF BLUE_RIGHT_X# > scrL# AND BLUE_RIGHT_X# < scrR# THEN
    lx# = BLUE_RIGHT_X# - camX#
    DRAWBOX X1 (lx# - LINE_HALF#), Y1 ICE_TOP#, X2 (lx# + LINE_HALF#), Y2 ICE_BOTTOM#, FILL YES
  END IF

  ' Center circle and dot
  SETCOLOR RED&
  IF CENTER_X# > scrL# AND CENTER_X# < scrR# THEN
    cx# = CENTER_X# - camX#
    DRAWCIRCLE X cx#, Y 240, RADIUS 60, FILL NO
    DRAWCIRCLE X cx#, Y 240, RADIUS 3, FILL YES
  END IF

  ' Faceoff circles and dots
  IF 200 > scrL# AND 200 < scrR# THEN
    DRAWCIRCLE X (200 - camX#), Y 150, RADIUS 60, FILL NO
    DRAWCIRCLE X (200 - camX#), Y 330, RADIUS 60, FILL NO
    DRAWCIRCLE X (200 - camX#), Y 150, RADIUS 3, FILL YES
    DRAWCIRCLE X (200 - camX#), Y 330, RADIUS 3, FILL YES
  END IF
  IF 1000 > scrL# AND 1000 < scrR# THEN
    DRAWCIRCLE X (1000 - camX#), Y 150, RADIUS 60, FILL NO
    DRAWCIRCLE X (1000 - camX#), Y 330, RADIUS 60, FILL NO
    DRAWCIRCLE X (1000 - camX#), Y 150, RADIUS 3, FILL YES
    DRAWCIRCLE X (1000 - camX#), Y 330, RADIUS 3, FILL YES
  END IF

  ' Neutral zone faceoff dots
  IF 470 > scrL# AND 470 < scrR# THEN
    DRAWCIRCLE X (470 - camX#), Y 150, RADIUS 3, FILL YES
    DRAWCIRCLE X (470 - camX#), Y 330, RADIUS 3, FILL YES
  END IF
  IF 730 > scrL# AND 730 < scrR# THEN
    DRAWCIRCLE X (730 - camX#), Y 150, RADIUS 3, FILL YES
    DRAWCIRCLE X (730 - camX#), Y 330, RADIUS 3, FILL YES
  END IF

  ' Goal creases
  SETCOLOR CREASE_COLOR&
  IF GOAL_LEFT_X# > scrL# AND GOAL_LEFT_X# < scrR# THEN
    DRAWCIRCLE X (GOAL_LEFT_X# - camX#), Y 240, RADIUS 25, FILL YES
    SETCOLOR WHITE&
    DRAWBOX X1 (GOAL_LEFT_X# - 26 - camX#), Y1 214, X2 (GOAL_LEFT_X# - camX#), Y2 266, FILL YES
  END IF
  SETCOLOR CREASE_COLOR&
  IF GOAL_RIGHT_X# > scrL# AND GOAL_RIGHT_X# < scrR# THEN
    DRAWCIRCLE X (GOAL_RIGHT_X# - camX#), Y 240, RADIUS 25, FILL YES
    SETCOLOR WHITE&
    DRAWBOX X1 (GOAL_RIGHT_X# - camX#), Y1 214, X2 (GOAL_RIGHT_X# + 26 - camX#), Y2 266, FILL YES
  END IF

  ' Goal nets
  goalTop# = 240 - GOAL_H# / 2
  goalBot# = 240 + GOAL_H# / 2

  ' Left goal net
  IF GOAL_LEFT_X# > scrL# AND GOAL_LEFT_X# < scrR# THEN
    lnx1# = GOAL_LEFT_X# - GOAL_W# - camX#
    lnx2# = GOAL_LEFT_X# - camX#
    ' White fill for net background
    SETCOLOR WHITE&
    DRAWBOX X1 lnx1#, Y1 goalTop#, X2 lnx2#, Y2 goalBot#, FILL YES
    ' Net mesh lines
    SETCOLOR LIGHTGRAY&
    FOR ny# FROM goalTop# TO goalBot# STEP 8
      DRAWLINE X1 lnx1#, Y1 ny#, X2 lnx2#, Y2 ny#
    END FOR
    DRAWLINE X1 (lnx1# + lnx2#) / 2, Y1 goalTop#, X2 (lnx1# + lnx2#) / 2, Y2 goalBot#
    ' Red frame
    SETCOLOR RED&
    DRAWBOX X1 lnx1#, Y1 goalTop#, X2 lnx2#, Y2 goalBot#, FILL NO
  END IF

  ' Right goal net
  IF GOAL_RIGHT_X# > scrL# AND GOAL_RIGHT_X# < scrR# THEN
    rnx1# = GOAL_RIGHT_X# - camX#
    rnx2# = GOAL_RIGHT_X# + GOAL_W# - camX#
    ' White fill for net background
    SETCOLOR WHITE&
    DRAWBOX X1 rnx1#, Y1 goalTop#, X2 rnx2#, Y2 goalBot#, FILL YES
    ' Net mesh lines
    SETCOLOR LIGHTGRAY&
    FOR ny# FROM goalTop# TO goalBot# STEP 8
      DRAWLINE X1 rnx1#, Y1 ny#, X2 rnx2#, Y2 ny#
    END FOR
    DRAWLINE X1 (rnx1# + rnx2#) / 2, Y1 goalTop#, X2 (rnx1# + rnx2#) / 2, Y2 goalBot#
    ' Red frame
    SETCOLOR RED&
    DRAWBOX X1 rnx1#, Y1 goalTop#, X2 rnx2#, Y2 goalBot#, FILL NO
  END IF

END FUNCTION

FUNCTION updateAnimations
  FOR i# FROM 1 TO 8
    pAnimTimer@[i#] = pAnimTimer@[i#] + 1
    anim# = pAnim@[i#]

    IF anim# = ANIM_SKATE# THEN
      IF pPushing@[i#] = 1 THEN
        IF pAnimTimer@[i#] >= SKATE_FRAME_TIME# THEN
          pAnimTimer@[i#] = 0
          pAnimFrame@[i#] = pAnimFrame@[i#] + 1
          IF pAnimFrame@[i#] > 3 THEN
            pAnimFrame@[i#] = 1
          END IF
        END IF
      ELSE
        pAnimFrame@[i#] = 2
        pAnimTimer@[i#] = 0
      END IF
    ELSE IF anim# = ANIM_SHOOT# THEN
      IF pAnimTimer@[i#] >= SHOOT_FRAME_TIME# THEN
        pAnimTimer@[i#] = 0
        pAnimFrame@[i#] = pAnimFrame@[i#] + 1
        IF pAnimFrame@[i#] > 3 THEN
          pAnimFrame@[i#] = 1
          pAnim@[i#] = ANIM_SKATE#
        END IF
      END IF
    ELSE IF anim# = ANIM_GOALIE_GLOVE# OR anim# = ANIM_GOALIE_BLOCKER# OR anim# = ANIM_GOALIE_SPLIT# THEN
      IF pAnimTimer@[i#] >= GOALIE_FRAME_TIME# THEN
        pAnimTimer@[i#] = 0
        pAnimFrame@[i#] = pAnimFrame@[i#] + 1
        IF pAnimFrame@[i#] > 2 THEN
          pAnimFrame@[i#] = 1
          pAnim@[i#] = ANIM_GOALIE_IDLE#
        END IF
      END IF
    END IF
  END FOR
END FUNCTION

FUNCTION getPlayerSprite# IDX idx#
  anim# = pAnim@[idx#]
  frame# = pAnimFrame@[idx#]
  isWhalers? = (idx# <= 4)

  IF anim# = ANIM_SKATE# THEN
    IF isWhalers? THEN
      result# = wSkate@[frame#]
    ELSE
      result# = oSkate@[frame#]
    END IF
  ELSE IF anim# = ANIM_SHOOT# THEN
    IF isWhalers? THEN
      result# = wShoot@[frame#]
    ELSE
      result# = oShoot@[frame#]
    END IF
  ELSE IF anim# = ANIM_GOALIE_IDLE# THEN
    IF isWhalers? THEN
      result# = wGoalieId#
    ELSE
      result# = oGoalieId#
    END IF
  ELSE IF anim# = ANIM_GOALIE_GLOVE# THEN
    IF isWhalers? THEN
      result# = wGoalieGlove@[frame#]
    ELSE
      result# = oGoalieGlove@[frame#]
    END IF
  ELSE IF anim# = ANIM_GOALIE_BLOCKER# THEN
    IF isWhalers? THEN
      result# = wGoalieBlocker@[frame#]
    ELSE
      result# = oGoalieBlocker@[frame#]
    END IF
  ELSE IF anim# = ANIM_GOALIE_SPLIT# THEN
    IF isWhalers? THEN
      result# = wGoalieSplit@[frame#]
    ELSE
      result# = oGoalieSplit@[frame#]
    END IF
  ELSE IF anim# = ANIM_KNOCKED# THEN
    IF isWhalers? THEN
      result# = wKnockedId#
    ELSE
      result# = oKnockedId#
    END IF
  END IF

  RETURN result#
END FUNCTION

FUNCTION drawPlayers
  FOR i# FROM 1 TO 8
    idx# = i#
    sx# = pX@[idx#] - camX#
    sy# = pY@[idx#]

    ' Skip if off screen
    IF sx# < -30 OR sx# > 670 THEN
      CONTINUE
    END IF

    ' Pick sprite based on team, position, and animation state
    sprId# = getPlayerSprite# IDX idx#

    ' Flip if facing left
    flip? = NO
    IF pDir@[idx#] = -1 THEN
      flip? = YES
    END IF

    ' Active player indicator
    IF idx# = activeP# THEN
      sprW# = SPRITEWIDTH# SPRITE sprId#
      SETCOLOR INDICATOR_COLOR&
      DRAWCIRCLE X (sx# + sprW# * PLAYER_SCALE# / 2), Y (sy# + 17 * PLAYER_SCALE#), RADIUS 18, FILL YES
    END IF

    ' Draw player
    DRAWSPRITE SPRITE sprId#, X sx#, Y sy#, SCALE PLAYER_SCALE#, FLIPH flip?

    ' Draw stick (skaters only, not goalies, knocked-down, or fighters)
    IF idx# <> 4 AND idx# <> 8 AND pAnim@[idx#] <> ANIM_KNOCKED# AND NOT (gameState# = STATE_FIGHT# AND (idx# = fightP1# OR idx# = fightP2#)) THEN
      SETCOLOR BROWN&

      ' Hand position (where stick shaft starts)
      IF pDir@[idx#] = 1 THEN
        shX# = sx# + 11 * PLAYER_SCALE#
      ELSE
        shX# = sx# + 5 * PLAYER_SCALE#
      END IF
      shY# = sy# + 10 * PLAYER_SCALE#

      ' Stick end position depends on state
      isCharging? = (idx# = activeP# AND shotCharging?)
      isShooting? = (pAnim@[idx#] = ANIM_SHOOT#)

      IF isCharging? THEN
        ' Wind-up: stick raised behind the player
        IF pDir@[idx#] = 1 THEN
          stX# = sx# + 5 * PLAYER_SCALE#
          stY# = sy# + 5 * PLAYER_SCALE#
        ELSE
          stX# = sx# + 11 * PLAYER_SCALE#
          stY# = sy# + 5 * PLAYER_SCALE#
        END IF
      ELSE IF isShooting? THEN
        ' Follow-through: stick extended far forward and low
        IF pDir@[idx#] = 1 THEN
          stX# = sx# + 17 * PLAYER_SCALE#
          stY# = sy# + 14 * PLAYER_SCALE#
        ELSE
          stX# = sx# - 5 * PLAYER_SCALE#
          stY# = sy# + 14 * PLAYER_SCALE#
        END IF
      ELSE
        ' Normal: stick forward and down
        IF pDir@[idx#] = 1 THEN
          stX# = sx# + 14 * PLAYER_SCALE#
          stY# = sy# + 13 * PLAYER_SCALE#
        ELSE
          stX# = sx# - 2 * PLAYER_SCALE#
          stY# = sy# + 13 * PLAYER_SCALE#
        END IF
      END IF

      DRAWLINE X1 shX#, Y1 shY#, X2 stX#, Y2 stY#
      ' Blade
      IF pDir@[idx#] = 1 THEN
        DRAWLINE X1 stX#, Y1 stY#, X2 (stX# + 2 * PLAYER_SCALE#), Y2 stY#
      ELSE
        DRAWLINE X1 stX#, Y1 stY#, X2 (stX# - 2 * PLAYER_SCALE#), Y2 stY#
      END IF
    END IF
  END FOR
END FUNCTION

FUNCTION drawPuck
  sx# = puckX# - camX#
  IF sx# > -10 AND sx# < 650 THEN
    DRAWSPRITE SPRITE puckSprId#, X sx#, Y puckY#, SCALE PUCK_SCALE#
  END IF
END FUNCTION

FUNCTION drawScore
  SETCOLOR WHITE&
  PRINTAT 25, 28, "WHR"
  PRINTAT 25, 32, scoreW#
  PRINTAT 25, 34, "-"
  PRINTAT 25, 36, scoreO#
  PRINTAT 25, 38, "OPP"
  cl$ = clockString$
  PRINTAT 25, 42, cl$
  dispP# = MIN# A period#, B NUM_PERIODS#
  PRINTAT 25, 50, "P"
  PRINTAT 25, 51, dispP#
END FUNCTION

FUNCTION handleInput
  keys@ = GETALLKEYS@
  inputX# = 0
  inputY# = 0
  inputShoot? = NO
  inputPass? = NO
  FOR ki# FROM 1 TO LENGTH# keys@
    k$ = keys@[ki#]
    IF k$ = "ArrowLeft" THEN
      inputX# = -1
    END IF
    IF k$ = "ArrowRight" THEN
      inputX# = 1
    END IF
    IF k$ = "ArrowUp" THEN
      inputY# = -1
    END IF
    IF k$ = "ArrowDown" THEN
      inputY# = 1
    END IF
    IF k$ = "z" OR k$ = "Z" THEN
      inputShoot? = YES
    END IF
    IF k$ = "x" OR k$ = "X" THEN
      inputPass? = YES
    END IF
  END FOR

  ' Edge detect pass button (fire once per press)
  passPressed? = NO
  IF inputPass? AND NOT prevPass? THEN
    passPressed? = YES
  END IF
  prevPass? = inputPass?
END FUNCTION

FUNCTION moveActivePlayer
  IF pState@[activeP#] = 2 THEN
    RETURN
  END IF

  rIdx# = pRoster@[activeP#]
  spd# = wSpeed@[rIdx#] * 0.4 + 2

  IF inputX# <> 0 OR inputY# <> 0 THEN
    pPushing@[activeP#] = 1

    ' Normalize diagonal
    IF inputX# <> 0 AND inputY# <> 0 THEN
      spd# = spd# * 0.707
    END IF
    pVX@[activeP#] = pVX@[activeP#] + inputX# * spd# * 0.3
    pVY@[activeP#] = pVY@[activeP#] + inputY# * spd# * 0.3

    ' Update facing direction
    IF inputX# <> 0 THEN
      pDir@[activeP#] = inputX#
    END IF
  ELSE
    pPushing@[activeP#] = 0
  END IF
END FUNCTION

FUNCTION updatePlayerPhysics
  FOR i# FROM 1 TO NUM_PLAYERS#
    ' Apply friction
    pVX@[i#] = pVX@[i#] * PLAYER_FRICTION#
    pVY@[i#] = pVY@[i#] * PLAYER_FRICTION#

    ' Clamp small velocities to zero
    IF ABS# VALUE pVX@[i#] < 0.1 THEN
      pVX@[i#] = 0
    END IF
    IF ABS# VALUE pVY@[i#] < 0.1 THEN
      pVY@[i#] = 0
    END IF

    ' Clamp to max speed (only SQRT when actually over limit)
    pSpd2# = pVX@[i#] * pVX@[i#] + pVY@[i#] * pVY@[i#]
    IF pSpd2# > PLAYER_MAX_SPEED# * PLAYER_MAX_SPEED# THEN
      pSpd# = SQRT# VALUE pSpd2#
      pVX@[i#] = pVX@[i#] / pSpd# * PLAYER_MAX_SPEED#
      pVY@[i#] = pVY@[i#] / pSpd# * PLAYER_MAX_SPEED#
    END IF

    ' Update position
    pX@[i#] = pX@[i#] + pVX@[i#]
    pY@[i#] = pY@[i#] + pVY@[i#]

    ' Clamp to ice bounds (goalies handled separately)
    IF i# = 4 OR i# = 8 THEN
      ' Goalie bounds — skip for now
    ELSE
      pX@[i#] = MAX# A pX@[i#], B ICE_LEFT#
      pX@[i#] = MIN# A pX@[i#], B (ICE_RIGHT# - 24)
      pY@[i#] = MAX# A pY@[i#], B ICE_TOP#
      pY@[i#] = MIN# A pY@[i#], B (ICE_BOTTOM# - 32)
    END IF

    ' Board bounce
    IF pX@[i#] <= ICE_LEFT# OR pX@[i#] >= (ICE_RIGHT# - 24) THEN
      pVX@[i#] = pVX@[i#] * -0.3
    END IF
    IF pY@[i#] <= ICE_TOP# OR pY@[i#] >= (ICE_BOTTOM# - 32) THEN
      pVY@[i#] = pVY@[i#] * -0.3
    END IF

    ' Update stun timer
    IF pState@[i#] = 2 THEN
      IF now# - pStateT@[i#] > STUN_DURATION# THEN
        pState@[i#] = 0
        pAnim@[i#] = ANIM_SKATE#
        pAnimFrame@[i#] = 2
        pAnimTimer@[i#] = 0
      END IF
    END IF
  END FOR
END FUNCTION

FUNCTION switchActivePlayer
  ' Only switch if no Whaler has puck (X = pass when Whaler has puck)
  IF puckOwner# >= 1 AND puckOwner# <= 3 THEN
    RETURN
  END IF

  bestDist2# = 99999999
  bestP# = activeP#

  FOR i# FROM 1 TO 3
    IF pState@[i#] = 2 THEN
      CONTINUE
    END IF
    dx# = pX@[i#] - puckX#
    dy# = pY@[i#] - puckY#
    d2# = dx# * dx# + dy# * dy#
    IF d2# < bestDist2# THEN
      bestDist2# = d2#
      bestP# = i#
    END IF
  END FOR

  activeP# = bestP#
END FUNCTION

FUNCTION updateTeammateAI
  FOR i# FROM 1 TO 3
    IF i# = activeP# THEN
      CONTINUE
    END IF
    IF pState@[i#] = 2 THEN
      CONTINUE
    END IF

    rIdx# = pRoster@[i#]
    spd# = wSpeed@[rIdx#] * 0.3 + 1.5
    pushStr# = 0.2
    targetX# = pX@[i#]
    targetY# = pY@[i#]

    ' If a pass is in flight, skate toward where the puck will be
    IF passInFlight? AND puckOwner# = 0 THEN
      targetX# = puckX# + puckVX# * 3
      targetY# = puckY# + puckVY# * 3
      pushStr# = 0.3

    ' If puck is loose, closest non-active Whaler chases it
    ELSE IF puckLoose? AND puckOwner# = 0 THEN
      closestW# = 0
      closestWD# = 9999999
      FOR ci# FROM 1 TO 3
        IF ci# = activeP# OR pState@[ci#] = 2 THEN
          CONTINUE
        END IF
        cdx# = pX@[ci#] - puckX#
        cdy# = pY@[ci#] - puckY#
        cd# = cdx# * cdx# + cdy# * cdy#
        IF cd# < closestWD# THEN
          closestWD# = cd#
          closestW# = ci#
        END IF
      END FOR
      IF i# = closestW# THEN
        targetX# = puckX#
        targetY# = puckY#
        pushStr# = 0.3
      ELSE
        defX# = puckX# - 80
        IF defX# < GOAL_LEFT_X# + 60 THEN
          defX# = GOAL_LEFT_X# + 60
        END IF
        IF i# = 1 THEN
          targetX# = defX#
          targetY# = puckY# - 60
        ELSE IF i# = 2 THEN
          targetX# = defX#
          targetY# = puckY# + 60
        ELSE
          targetX# = defX# + 40
          targetY# = puckY#
        END IF
      END IF

    ' Active player or teammate has the puck — get open for a pass
    ELSE IF puckOwner# >= 1 AND puckOwner# <= 3 THEN
      carrierX# = pX@[puckOwner#]

      IF i# = 1 THEN
        laneY# = 150
      ELSE IF i# = 2 THEN
        laneY# = 330
      ELSE
        laneY# = 240
      END IF

      targetX# = carrierX# + 100 + SIN# VALUE (now# * 0.001 + i# * 3) * 30
      targetY# = laneY# + SIN# VALUE (now# * 0.002 + i# * 2) * 40

      ' Stay away from nearest opponent (squared distance, no SQRT)
      nearOppD2# = 9999999
      nearOppY# = targetY#
      FOR oi# FROM 5 TO 7
        ox# = pX@[oi#] - targetX#
        oy# = pY@[oi#] - targetY#
        od2# = ox# * ox# + oy# * oy#
        IF od2# < nearOppD2# THEN
          nearOppD2# = od2#
          nearOppY# = pY@[oi#]
        END IF
      END FOR
      IF nearOppD2# < 6400 THEN
        IF targetY# > nearOppY# THEN
          targetY# = targetY# + 30
        ELSE
          targetY# = targetY# - 30
        END IF
      END IF
      pushStr# = 0.25

    ELSE
      defX# = puckX# - 80
      IF defX# < GOAL_LEFT_X# + 60 THEN
        defX# = GOAL_LEFT_X# + 60
      END IF
      IF i# = 1 THEN
        targetX# = defX#
        targetY# = puckY# - 60
      ELSE IF i# = 2 THEN
        targetX# = defX#
        targetY# = puckY# + 60
      ELSE
        targetX# = defX# + 40
        targetY# = puckY#
      END IF
    END IF

    ' Clamp targets to ice
    targetX# = MAX# A targetX#, B (ICE_LEFT# + 30)
    targetY# = MAX# A targetY#, B (ICE_TOP# + 20)
    targetX# = MIN# A targetX#, B (ICE_RIGHT# - 50)
    targetY# = MIN# A targetY#, B (ICE_BOTTOM# - 50)

    ' Move toward target (skip SQRT if close)
    dx# = targetX# - pX@[i#]
    dy# = targetY# - pY@[i#]
    d2# = dx# * dx# + dy# * dy#

    IF d2# > 100 THEN
      dist# = SQRT# VALUE d2#
      pPushing@[i#] = 1
      pVX@[i#] = pVX@[i#] + (dx# / dist#) * spd# * pushStr#
      pVY@[i#] = pVY@[i#] + (dy# / dist#) * spd# * pushStr#
    ELSE
      pPushing@[i#] = 0
    END IF

    IF dx# > 5 THEN
      pDir@[i#] = 1
    ELSE IF dx# < -5 THEN
      pDir@[i#] = -1
    END IF
  END FOR
END FUNCTION

FUNCTION updateOpponentAI
  FOR i# FROM 5 TO 7
    IF pState@[i#] = 2 THEN
      CONTINUE
    END IF

    rIdx# = pRoster@[i#]
    spd# = oSpeed@[rIdx#] * 0.3 + 1.5
    pushStr# = 0.2

    IF puckOwner# = i# THEN
      ' === This opponent has the puck ===
      distToGoal# = pX@[i#] - GOAL_LEFT_X#

      ' Check if a Whaler is close (pressure) — squared dist, no SQRT
      underPressure? = NO
      FOR wi# FROM 1 TO 3
        wpx# = pX@[wi#] - pX@[i#]
        wpy# = pY@[wi#] - pY@[i#]
        IF wpx# * wpx# + wpy# * wpy# < 3600 THEN
          underPressure? = YES
        END IF
      END FOR

      ' Consider passing when under pressure (low chance per frame)
      IF underPressure? AND RANDOM# MAX 100 < 4 THEN
        ' Find closest open teammate (simplified — no nested Whaler loop)
        bestPassIdx# = 0
        bestPassD2# = 9999999
        FOR ti# FROM 5 TO 7
          IF ti# = i# OR pState@[ti#] = 2 THEN
            CONTINUE
          END IF
          tdx# = pX@[ti#] - pX@[i#]
          tdy# = pY@[ti#] - pY@[i#]
          td2# = tdx# * tdx# + tdy# * tdy#
          IF td2# > 1600 AND td2# < bestPassD2# THEN
            bestPassD2# = td2#
            bestPassIdx# = ti#
          END IF
        END FOR

        IF bestPassIdx# > 0 THEN
          pdx# = pX@[bestPassIdx#] - puckX#
          pdy# = pY@[bestPassIdx#] - puckY#
          pDist# = SQRT# VALUE (pdx# * pdx# + pdy# * pdy#)
          IF pDist# > 0 THEN
            puckVX# = (pdx# / pDist#) * PASS_SPEED#
            puckVY# = (pdy# / pDist#) * PASS_SPEED#
          END IF
          pHasPuck@[i#] = 0
          puckOwner# = 0
          puckLoose? = YES
          puckFreezeUntil# = now# + 150
          CONTINUE
        END IF
      END IF

      ' Shoot if close enough
      IF distToGoal# < 250 THEN
        shootChance# = 3
        IF distToGoal# < 150 THEN
          shootChance# = 6
        END IF
        IF distToGoal# < 100 THEN
          shootChance# = 12
        END IF
        IF RANDOM# MAX 100 < shootChance# THEN
          sdx# = GOAL_LEFT_X# - puckX#
          goalAimY# = 240 + RANDOM# MAX 40 - 20
          sdy# = goalAimY# - puckY#
          sDist# = SQRT# VALUE (sdx# * sdx# + sdy# * sdy#)
          oPower# = SHOT_POWER_MIN# + (SHOT_POWER_MAX# - SHOT_POWER_MIN#) * 0.7
          oPower# = oPower# * (0.7 + oShot@[rIdx#] * 0.03)
          IF sDist# > 0 THEN
            puckVX# = (sdx# / sDist#) * oPower#
            puckVY# = (sdy# / sDist#) * oPower#
          ELSE
            puckVX# = 0 - oPower#
            puckVY# = 0
          END IF
          pHasPuck@[i#] = 0
          puckOwner# = 0
          puckLoose? = YES
          puckFreezeUntil# = now# + 200
          pAnim@[i#] = ANIM_SHOOT#
          pAnimFrame@[i#] = 1
          pAnimTimer@[i#] = 0
          CONTINUE
        END IF
      END IF

      ' Skate toward goal, weaving to avoid defenders
      targetX# = GOAL_LEFT_X# + 80
      targetY# = 240 + SIN# VALUE (now# * 0.003) * 60
      pushStr# = 0.3

    ELSE IF puckOwner# >= 5 AND puckOwner# <= 7 THEN
      ' === Teammate has puck — get open ===
      carrierX# = pX@[puckOwner#]

      IF i# = 5 THEN
        laneY# = 160
      ELSE IF i# = 6 THEN
        laneY# = 320
      ELSE
        laneY# = 240
      END IF

      targetX# = carrierX# - 100 + SIN# VALUE (now# * 0.001 + i# * 3) * 25
      targetY# = laneY# + SIN# VALUE (now# * 0.002 + i# * 2) * 40

      ' Avoid nearest Whaler — squared distance
      nearWD2# = 9999999
      nearWY# = targetY#
      FOR wi# FROM 1 TO 3
        wx# = pX@[wi#] - targetX#
        wy# = pY@[wi#] - targetY#
        wd2# = wx# * wx# + wy# * wy#
        IF wd2# < nearWD2# THEN
          nearWD2# = wd2#
          nearWY# = pY@[wi#]
        END IF
      END FOR
      IF nearWD2# < 4900 THEN
        IF targetY# > nearWY# THEN
          targetY# = targetY# + 25
        ELSE
          targetY# = targetY# - 25
        END IF
      END IF
      pushStr# = 0.25

    ELSE
      ' === Puck loose or Whalers have it ===
      closestOpp# = 5
      closestD2# = 9999999
      FOR ci# FROM 5 TO 7
        IF pState@[ci#] = 2 THEN
          CONTINUE
        END IF
        cdx# = pX@[ci#] - puckX#
        cdy# = pY@[ci#] - puckY#
        cd2# = cdx# * cdx# + cdy# * cdy#
        IF cd2# < closestD2# THEN
          closestD2# = cd2#
          closestOpp# = ci#
        END IF
      END FOR

      IF i# = closestOpp# THEN
        IF puckLoose? THEN
          targetX# = puckX#
          targetY# = puckY#
        ELSE
          targetX# = pX@[puckOwner#]
          targetY# = pY@[puckOwner#]
        END IF
        pushStr# = 0.3
      ELSE
        defX# = puckX# + 80
        IF defX# > GOAL_RIGHT_X# - 60 THEN
          defX# = GOAL_RIGHT_X# - 60
        END IF
        IF i# = 5 THEN
          targetX# = defX#
          targetY# = puckY# - 60
        ELSE IF i# = 6 THEN
          targetX# = defX#
          targetY# = puckY# + 60
        ELSE
          targetX# = defX# - 40
          targetY# = puckY#
        END IF
      END IF
    END IF

    ' Clamp targets to ice
    targetX# = MAX# A targetX#, B (ICE_LEFT# + 30)
    targetY# = MAX# A targetY#, B (ICE_TOP# + 20)
    targetX# = MIN# A targetX#, B (ICE_RIGHT# - 50)
    targetY# = MIN# A targetY#, B (ICE_BOTTOM# - 50)

    ' Move toward target (skip SQRT if close)
    dx# = targetX# - pX@[i#]
    dy# = targetY# - pY@[i#]
    d2# = dx# * dx# + dy# * dy#

    IF d2# > 100 THEN
      dist# = SQRT# VALUE d2#
      pPushing@[i#] = 1
      pVX@[i#] = pVX@[i#] + (dx# / dist#) * spd# * pushStr#
      pVY@[i#] = pVY@[i#] + (dy# / dist#) * spd# * pushStr#
    ELSE
      pPushing@[i#] = 0
    END IF

    IF dx# > 5 THEN
      pDir@[i#] = 1
    ELSE IF dx# < -5 THEN
      pDir@[i#] = -1
    END IF
  END FOR
END FUNCTION

FUNCTION updateGoalieAI
  FOR gi# FROM 1 TO 2
    IF gi# = 1 THEN
      g# = 4
      homeX# = GOAL_LEFT_X# + 5
      clearDirX# = 1
      minGX# = GOAL_LEFT_X# - 15
      maxGX# = GOAL_LEFT_X# + 25
      ' Shot coming toward this goal = puck moving left
      shotComing? = (puckLoose? AND puckVX# < -3 AND puckX# < 300)
    ELSE
      g# = 8
      homeX# = GOAL_RIGHT_X# - 55
      clearDirX# = -1
      minGX# = GOAL_RIGHT_X# - 75
      maxGX# = GOAL_RIGHT_X# - 35
      ' Shot coming toward this goal = puck moving right
      shotComing? = (puckLoose? AND puckVX# > 3 AND puckX# > 900)
    END IF

    IF pState@[g#] = 2 THEN
      CONTINUE
    END IF

    minGY# = 240 - GOAL_H# / 2 - 30
    maxGY# = 240 + GOAL_H# / 2 - 30

    IF puckOwner# = g# THEN
      ' === Goalie has puck — hold briefly then clear it ===
      holdTime# = now# - goalieHoldTime#
      IF holdTime# < 500 THEN
        ' Brief hold — drift toward center
        dy# = 240 - pY@[g#]
        IF dy# > 5 THEN
          pVY@[g#] = pVY@[g#] + 0.3
        ELSE IF dy# < -5 THEN
          pVY@[g#] = pVY@[g#] - 0.3
        END IF
      ELSE
        ' Clear it forward
        puckVX# = clearDirX# * PASS_SPEED# * 0.8
        puckVY# = (RANDOM# MAX 60 - 30) * 0.1
        pHasPuck@[g#] = 0
        puckOwner# = 0
        puckLoose? = YES
        puckFreezeUntil# = now# + 150
      END IF

    ELSE
      ' === Track puck Y, stay at home X ===
      targetY# = puckY#
      targetY# = MAX# A targetY#, B minGY#
      targetY# = MIN# A targetY#, B maxGY#

      dy# = targetY# - pY@[g#]
      IF dy# > 3 THEN
        pVY@[g#] = pVY@[g#] + 1.5
      ELSE IF dy# < -3 THEN
        pVY@[g#] = pVY@[g#] - 1.5
      END IF

      ' Stay near goal line
      dx# = homeX# - pX@[g#]
      IF dx# > 3 THEN
        pVX@[g#] = pVX@[g#] + 0.5
      ELSE IF dx# < -3 THEN
        pVX@[g#] = pVX@[g#] - 0.5
      END IF

      ' Trigger random save animation when a shot is incoming
      IF shotComing? AND pAnim@[g#] = ANIM_GOALIE_IDLE# THEN
        saveType# = RANDOM# MAX 3
        IF saveType# = 1 THEN
          pAnim@[g#] = ANIM_GOALIE_GLOVE#
        ELSE IF saveType# = 2 THEN
          pAnim@[g#] = ANIM_GOALIE_BLOCKER#
        ELSE
          pAnim@[g#] = ANIM_GOALIE_SPLIT#
        END IF
        pAnimFrame@[g#] = 1
        pAnimTimer@[g#] = 0
      END IF
    END IF

    ' Clamp goalie to crease area
    pX@[g#] = MAX# A pX@[g#], B minGX#
    pX@[g#] = MIN# A pX@[g#], B maxGX#
    pY@[g#] = MAX# A pY@[g#], B minGY#
    pY@[g#] = MIN# A pY@[g#], B maxGY#

    ' Face the puck
    IF puckX# > pX@[g#] THEN
      pDir@[g#] = 1
    ELSE
      pDir@[g#] = -1
    END IF
  END FOR
END FUNCTION

FUNCTION updatePuck
  IF puckOwner# > 0 THEN
    ' Puck attached to carrier (on stick blade)
    offX# = 14
    IF pDir@[puckOwner#] = -1 THEN
      offX# = -2
    END IF
    puckX# = pX@[puckOwner#] + offX# * PLAYER_SCALE#
    puckY# = pY@[puckOwner#] + 13 * PLAYER_SCALE#
    puckVX# = 0
    puckVY# = 0
    RETURN
  END IF

  ' Apply friction
  puckVX# = puckVX# * PUCK_FRICTION#
  puckVY# = puckVY# * PUCK_FRICTION#

  ' Clamp tiny velocities
  IF ABS# VALUE puckVX# < 0.05 THEN
    puckVX# = 0
  END IF
  IF ABS# VALUE puckVY# < 0.05 THEN
    puckVY# = 0
  END IF

  ' Update position
  puckX# = puckX# + puckVX#
  puckY# = puckY# + puckVY#

  ' Board collision (top/bottom bounce)
  IF puckY# < ICE_TOP# THEN
    puckY# = ICE_TOP#
    puckVY# = ABS# VALUE puckVY# * 0.7
  END IF
  IF puckY# > ICE_BOTTOM# - 8 THEN
    puckY# = ICE_BOTTOM# - 8
    puckVY# = 0 - ABS# VALUE puckVY# * 0.7
  END IF

  ' Left/right boards (but not in goal mouth)
  IF puckX# < ICE_LEFT# THEN
    IF puckY# > 240 - GOAL_H# / 2 AND puckY# < 240 + GOAL_H# / 2 THEN
      ' Into left goal area — let checkGoals handle it
    ELSE
      puckX# = ICE_LEFT#
      puckVX# = ABS# VALUE puckVX# * 0.7
    END IF
  END IF
  IF puckX# > ICE_RIGHT# - 8 THEN
    IF puckY# > 240 - GOAL_H# / 2 AND puckY# < 240 + GOAL_H# / 2 THEN
      ' Into right goal area — let checkGoals handle it
    ELSE
      puckX# = ICE_RIGHT# - 8
      puckVX# = 0 - ABS# VALUE puckVX# * 0.7
    END IF
  END IF

  ' Pickup detection (if not frozen)
  IF now# > puckFreezeUntil# THEN
    FOR i# FROM 1 TO NUM_PLAYERS#
      IF pState@[i#] = 2 THEN
        CONTINUE
      END IF
      dx# = pX@[i#] + 8 * PLAYER_SCALE# - puckX#
      dy# = pY@[i#] + 10 * PLAYER_SCALE# - puckY#
      dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)
      IF dist# < 20 THEN
        ' One-timer check: Whaler picking up a pass while Z held
        IF passInFlight? AND now# - passTime# < 500 THEN
          IF i# >= 1 AND i# <= 3 AND i# <> activeP# AND inputShoot? THEN
            ' ONE-TIMER! Auto-shoot with bonus power
            otPower# = SHOT_POWER_MAX# * 1.3
            gdx# = GOAL_RIGHT_X# - puckX#
            gdy# = 240 - puckY#
            gDist# = SQRT# VALUE (gdx# * gdx# + gdy# * gdy#)
            IF gDist# > 0 THEN
              puckVX# = (gdx# / gDist#) * otPower#
              puckVY# = (gdy# / gDist#) * otPower#
            ELSE
              puckVX# = otPower#
              puckVY# = 0
            END IF
            puckOwner# = 0
            puckLoose? = YES
            puckFreezeUntil# = now# + 200
            passInFlight? = NO
            activeP# = i#
            RETURN
          END IF
        END IF

        puckOwner# = i#
        puckLoose? = NO
        pHasPuck@[i#] = 1
        passInFlight? = NO
        ' Auto-switch to Whaler who picks up puck
        IF i# >= 1 AND i# <= 3 THEN
          activeP# = i#
        END IF
        ' Track when goalie gets the puck
        IF i# = 4 OR i# = 8 THEN
          goalieHoldTime# = now#
        END IF
        BREAK
      END IF
    END FOR
  END IF
END FUNCTION

FUNCTION handleShooting
  ap# = activeP#

  ' Only the active player shoots via human input
  IF puckOwner# <> ap# THEN
    shotCharging? = NO
    RETURN
  END IF

  IF inputShoot? THEN
    IF NOT shotCharging? THEN
      ' Start charging
      shotCharging? = YES
      shotChargeStart# = now#
    END IF
  ELSE
    IF shotCharging? THEN
      ' Release shot!
      chargeMs# = now# - shotChargeStart#
      chargePct# = MIN# A (chargeMs# / SHOT_CHARGE_TIME#), B 1.0

      rIdx# = pRoster@[ap#]
      shotStat# = wShot@[rIdx#]
      power# = SHOT_POWER_MIN# + chargePct# * (SHOT_POWER_MAX# - SHOT_POWER_MIN#)
      power# = power# * (0.7 + shotStat# * 0.03)

      ' Shot direction: toward opponent goal
      goalY# = 240
      dx# = GOAL_RIGHT_X# - puckX#
      dy# = goalY# - puckY#
      dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)

      IF dist# > 0 THEN
        puckVX# = (dx# / dist#) * power#
        puckVY# = (dy# / dist#) * power#
      ELSE
        puckVX# = power#
        puckVY# = 0
      END IF

      ' Release puck
      pHasPuck@[ap#] = 0
      puckOwner# = 0
      puckLoose? = YES
      puckFreezeUntil# = now# + 200

      ' Trigger shoot animation
      pAnim@[ap#] = ANIM_SHOOT#
      pAnimFrame@[ap#] = 1
      pAnimTimer@[ap#] = 0

      shotCharging? = NO
    END IF
  END IF
END FUNCTION

FUNCTION handlePassing
  ap# = activeP#

  IF NOT passPressed? THEN
    RETURN
  END IF
  IF puckOwner# <> ap# THEN
    ' No puck — switch player instead
    switchActivePlayer
    RETURN
  END IF

  ' Determine input direction (default to facing)
  dirX# = inputX#
  dirY# = inputY#
  IF dirX# = 0 AND dirY# = 0 THEN
    dirX# = pDir@[ap#]
  END IF

  ' Find teammate most aligned with input direction
  ' Use dot product between input direction and direction-to-teammate
  bestDot# = -99999
  bestTarget# = 0
  FOR ti# FROM 1 TO 3
    IF ti# = ap# THEN
      CONTINUE
    END IF
    IF pState@[ti#] = 2 THEN
      CONTINUE
    END IF
    ' Direction from passer to teammate
    tdx# = pX@[ti#] - pX@[ap#]
    tdy# = pY@[ti#] - pY@[ap#]
    tDist# = SQRT# VALUE (tdx# * tdx# + tdy# * tdy#)
    IF tDist# < 10 THEN
      CONTINUE
    END IF
    tdx# = tdx# / tDist#
    tdy# = tdy# / tDist#
    ' Dot product with input direction
    dot# = tdx# * dirX# + tdy# * dirY#
    IF dot# > bestDot# THEN
      bestDot# = dot#
      bestTarget# = ti#
    END IF
  END FOR

  ' Aim pass at where the target teammate will be
  IF bestTarget# > 0 THEN
    ' Estimate travel time: distance / pass speed
    rawDX# = pX@[bestTarget#] - puckX#
    rawDY# = pY@[bestTarget#] - puckY#
    rawDist# = SQRT# VALUE (rawDX# * rawDX# + rawDY# * rawDY#)
    IF rawDist# > 0 THEN
      travelFrames# = rawDist# / PASS_SPEED#
    ELSE
      travelFrames# = 0
    END IF
    ' Lead the target based on their velocity
    leadX# = pX@[bestTarget#] + pVX@[bestTarget#] * travelFrames# * 0.6
    leadY# = pY@[bestTarget#] + pVY@[bestTarget#] * travelFrames# * 0.6
    passDX# = leadX# - puckX#
    passDY# = leadY# - puckY#
    pDist# = SQRT# VALUE (passDX# * passDX# + passDY# * passDY#)
    IF pDist# > 0 THEN
      passDX# = passDX# / pDist#
      passDY# = passDY# / pDist#
    END IF
  ELSE
    ' No valid target — pass in raw input direction
    pDist# = SQRT# VALUE (dirX# * dirX# + dirY# * dirY#)
    IF pDist# > 0 THEN
      passDX# = dirX# / pDist#
      passDY# = dirY# / pDist#
    ELSE
      passDX# = pDir@[ap#]
      passDY# = 0
    END IF
  END IF

  ' Release puck
  puckVX# = passDX# * PASS_SPEED#
  puckVY# = passDY# * PASS_SPEED#
  pHasPuck@[ap#] = 0
  puckOwner# = 0
  puckLoose? = YES
  puckFreezeUntil# = now# + 150

  ' Trigger swing animation
  pAnim@[ap#] = ANIM_SHOOT#
  pAnimFrame@[ap#] = 1
  pAnimTimer@[ap#] = 0

  passInFlight? = YES
  passTime# = now#
END FUNCTION

FUNCTION handleChecking
  ap# = activeP#

  ' Z = check only when active player doesn't have the puck
  IF puckOwner# = ap# THEN
    RETURN
  END IF
  IF NOT inputShoot? THEN
    RETURN
  END IF
  IF now# < checkCooldown# THEN
    RETURN
  END IF

  ' Lunge in facing direction
  lungeDir# = pDir@[ap#]
  pVX@[ap#] = pVX@[ap#] + lungeDir# * CHECK_POWER# * 1.5
  checkCooldown# = now# + CHECK_COOLDOWN_MS#

  ' Check for collision with opponents
  rIdx# = pRoster@[ap#]
  checkStat# = wCheck@[rIdx#]

  FOR i# FROM 5 TO 7
    IF pState@[i#] = 2 THEN
      CONTINUE
    END IF
    dx# = pX@[i#] - pX@[ap#]
    dy# = pY@[i#] - pY@[ap#]
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)

    IF dist# < CHECK_RADIUS# * PLAYER_SCALE# THEN
      ' HIT!
      hitPower# = checkStat# * 0.5 + 3

      ' Knock opponent back
      IF dist# > 0 THEN
        knockX# = dx# / dist# * hitPower#
        knockY# = dy# / dist# * hitPower#
      ELSE
        knockX# = lungeDir# * hitPower#
        knockY# = 0
      END IF

      pVX@[i#] = pVX@[i#] + knockX#
      pVY@[i#] = pVY@[i#] + knockY#
      pState@[i#] = 2
      pStateT@[i#] = now#
      pAnim@[i#] = ANIM_KNOCKED#
      pAnimFrame@[i#] = 1
      pAnimTimer@[i#] = 0

      ' If checked player had puck, drop it
      IF puckOwner# = i# THEN
        pHasPuck@[i#] = 0
        puckOwner# = 0
        puckLoose? = YES
        puckVX# = knockX# * 0.5
        puckVY# = knockY# * 0.5
      END IF

      ' Chance to trigger fight
      IF RANDOM# MAX 100 < FIGHT_CHANCE# THEN
        fightP1# = ap#
        fightP2# = i#
        startFight
      END IF

      BREAK
    END IF
  END FOR
END FUNCTION

FUNCTION handleOpponentChecking
  ' Opponents check the puck carrier if close enough
  IF puckOwner# < 1 OR puckOwner# > 3 THEN
    RETURN
  END IF

  FOR i# FROM 5 TO 7
    IF pState@[i#] = 2 THEN
      CONTINUE
    END IF

    dx# = pX@[puckOwner#] - pX@[i#]
    dy# = pY@[puckOwner#] - pY@[i#]
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)

    IF dist# < CHECK_RADIUS# * PLAYER_SCALE# THEN
      ' Random chance to check (roughly 1 in 30 frames when in range)
      IF RANDOM# MAX 100 < 3 THEN
        rIdx# = pRoster@[i#]
        hitPower# = oCheck@[rIdx#] * 0.5 + 3

        IF dist# > 0 THEN
          knockX# = dx# / dist# * hitPower#
          knockY# = dy# / dist# * hitPower#
        ELSE
          knockX# = pDir@[i#] * hitPower#
          knockY# = 0
        END IF

        carrier# = puckOwner#
        pVX@[carrier#] = pVX@[carrier#] + knockX#
        pVY@[carrier#] = pVY@[carrier#] + knockY#
        pState@[carrier#] = 2
        pStateT@[carrier#] = now#
        pAnim@[carrier#] = ANIM_KNOCKED#
        pAnimFrame@[carrier#] = 1
        pAnimTimer@[carrier#] = 0

        ' Drop puck
        pHasPuck@[carrier#] = 0
        puckOwner# = 0
        puckLoose? = YES
        puckVX# = knockX# * 0.5
        puckVY# = knockY# * 0.5

        ' Chance to trigger fight
        IF RANDOM# MAX 100 < FIGHT_CHANCE# THEN
          fightP1# = carrier#
          fightP2# = i#
          startFight
        END IF

        BREAK
      END IF
    END IF
  END FOR
END FUNCTION

FUNCTION checkGoals
  ' Whalers defend LEFT goal, opponent defends RIGHT
  scored? = NO

  ' Check right goal (opponent's goal — Whalers score)
  IF puckX# > GOAL_RIGHT_X# + GOAL_W# THEN
    IF puckY# > 240 - GOAL_H# / 2 AND puckY# < 240 + GOAL_H# / 2 THEN
      scoreW# = scoreW# + 1
      lastGoalTeam# = 1
      scored? = YES
    END IF
  END IF

  ' Check left goal (Whalers' goal — opponent scores)
  IF puckX# < GOAL_LEFT_X# - GOAL_W# THEN
    IF puckY# > 240 - GOAL_H# / 2 AND puckY# < 240 + GOAL_H# / 2 THEN
      scoreO# = scoreO# + 1
      lastGoalTeam# = 2
      scored? = YES
    END IF
  END IF

  IF scored? THEN
    ' Clear puck state — puck stays where it is (in the net)
    FOR i# FROM 1 TO NUM_PLAYERS#
      pHasPuck@[i#] = 0
    END FOR
    puckOwner# = 0
    puckLoose? = YES
    puckVX# = 0
    puckVY# = 0
    puckFreezeUntil# = now# + 99999
    shotCharging? = NO
    passInFlight? = NO

    ' Go to goal celebration
    goalCellyStart# = now#
    gameState# = STATE_GOAL#
    ' Goal horn — long low blast
    PLAYPOLY ["T90 L2 O4 C" WAVE "sawtooth"] ["T90 L2 O4 E" WAVE "sawtooth"] ["T90 L2 O4 G" WAVE "sawtooth"], BACKGROUND YES, REPEAT YES
  END IF
END FUNCTION

' ============ FACEOFFS ============

FUNCTION setNearestFaceoffDot
  bestD2# = 99999999
  FOR fd# FROM 1 TO 5
    dx# = puckX# - faceDotX@[fd#]
    dy# = puckY# - faceDotY@[fd#]
    d2# = dx# * dx# + dy# * dy#
    IF d2# < bestD2# THEN
      bestD2# = d2#
      faceoffDot# = fd#
    END IF
  END FOR
END FUNCTION

FUNCTION setupFaceoff
  fx# = faceDotX@[faceoffDot#]
  fy# = faceDotY@[faceoffDot#]

  ' Centers at faceoff dot
  pX@[1] = fx# - 15
  pY@[1] = fy#
  pDir@[1] = 1
  pX@[5] = fx# + 15
  pY@[5] = fy#
  pDir@[5] = -1

  ' Wings spread out
  pX@[2] = fx# - 60
  pY@[2] = fy# - 40
  pDir@[2] = 1
  pX@[3] = fx# - 60
  pY@[3] = fy# + 40
  pDir@[3] = 1

  pX@[6] = fx# + 60
  pY@[6] = fy# - 40
  pDir@[6] = -1
  pX@[7] = fx# + 60
  pY@[7] = fy# + 40
  pDir@[7] = -1

  ' Goalies at their nets
  pX@[4] = GOAL_LEFT_X# + 5
  pY@[4] = 210
  pDir@[4] = 1
  pX@[8] = GOAL_RIGHT_X# - 55
  pY@[8] = 210
  pDir@[8] = -1

  ' Clear all velocities and states
  FOR i# FROM 1 TO NUM_PLAYERS#
    pVX@[i#] = 0
    pVY@[i#] = 0
    pState@[i#] = 0
    pAnim@[i#] = ANIM_SKATE#
    IF i# = 4 OR i# = 8 THEN
      pAnim@[i#] = ANIM_GOALIE_IDLE#
    END IF
  END FOR

  ' Puck at faceoff dot, frozen until drop
  puckX# = fx#
  puckY# = fy#
  puckVX# = 0
  puckVY# = 0
  puckOwner# = 0
  puckLoose? = YES
  puckFreezeUntil# = now# + 99999

  activeP# = 1
  faceoffWait# = now#
END FUNCTION

FUNCTION updateFaceoff
  ' Wait 1.5 seconds then drop puck
  IF now# - faceoffWait# > 1500 THEN
    puckFreezeUntil# = now#
    lastClockTick# = now#
    gameState# = STATE_PLAY#
  END IF
END FUNCTION

' ============ CLOCK ============

FUNCTION updateClock
  IF gameState# <> STATE_PLAY# THEN
    RETURN
  END IF

  IF now# - lastClockTick# >= 100 THEN
    elapsed# = (now# - lastClockTick#) / 1000
    clockTime# = clockTime# - elapsed# * CLOCK_RATIO#
    lastClockTick# = now#

    IF clockTime# <= 0 THEN
      clockTime# = 0
      period# = period# + 1
      IF period# > NUM_PERIODS# THEN
        gameState# = STATE_GAME_OVER#
      ELSE
        periodEndStart# = now#
        gameState# = STATE_PERIOD_END#
      END IF
    END IF
  END IF
END FUNCTION

FUNCTION clockString$
  minutes# = FLOOR# VALUE (clockTime# / 60)
  seconds# = FLOOR# VALUE (clockTime# - minutes# * 60)
  m$ = TOSTRING$ minutes#
  s$ = TOSTRING$ seconds#
  IF seconds# < 10 THEN
    s$ = "0" + s$
  END IF
  RETURN m$ + ":" + s$
END FUNCTION

' ============ GOAL CELEBRATION ============

FUNCTION updateGoalCelly
  IF now# - goalCellyStart# > 3000 THEN
    STOPPLAY
    faceoffDot# = 1
    setupFaceoff
    gameState# = STATE_FACEOFF#
  END IF
END FUNCTION

FUNCTION drawGoalCelly
  ' Flash "GOAL!" text
  flash# = FLOOR# VALUE ((now# - goalCellyStart#) / 200)
  IF flash# % 2 = 0 THEN
    SETCOLOR RED&
  ELSE
    SETCOLOR WHITE&
  END IF

  IF lastGoalTeam# = 1 THEN
    PRINTAT 10, 30, "WHALERS GOAL!"
  ELSE
    PRINTAT 10, 30, "OPPONENT GOAL!"
  END IF

  ' Goal light — flashing red circle behind the net
  lightOn? = (flash# % 2 = 0)
  IF lightOn? THEN
    SETCOLOR RED&
  ELSE
    SETCOLOR DARKRED&
  END IF
  IF lastGoalTeam# = 1 THEN
    ' Whalers scored — light behind right goal
    DRAWCIRCLE X (GOAL_RIGHT_X# + 20 - camX#), Y 240, RADIUS 12, FILL YES
  ELSE
    ' Opponent scored — light behind left goal
    DRAWCIRCLE X (GOAL_LEFT_X# - 20 - camX#), Y 240, RADIUS 12, FILL YES
  END IF
END FUNCTION

' ============ PERIOD END ============

FUNCTION updatePeriodEnd
  IF now# - periodEndStart# > 3000 THEN
    clockTime# = PERIOD_GAME_SECONDS#
    faceoffDot# = 1
    setupFaceoff
    gameState# = STATE_FACEOFF#
  END IF
END FUNCTION

FUNCTION drawPeriodEnd
  SETCOLOR WHITE&
  p# = period# - 1
  PRINTAT 10, 32, "END OF PERIOD"
  PRINTAT 12, 36, p#
  PRINTAT 14, 30, "WHR " + TOSTRING$ scoreW# + " - " + TOSTRING$ scoreO# + " OPP"
END FUNCTION

' ============ GAME OVER ============

FUNCTION drawGameOver
  SETCOLOR WHITE&
  PRINTAT 8, 34, "GAME OVER"
  PRINTAT 10, 30, "WHR " + TOSTRING$ scoreW# + " - " + TOSTRING$ scoreO# + " OPP"
  IF scoreW# > scoreO# THEN
    PRINTAT 12, 32, "WHALERS WIN!"
  ELSE IF scoreO# > scoreW# THEN
    PRINTAT 12, 31, "OPPONENT WINS!"
  ELSE
    PRINTAT 12, 36, "TIE GAME"
  END IF
END FUNCTION

' ============ FIGHTING ============

FUNCTION startFight
  fightHP1# = 100
  fightHP2# = 100
  fightCooldown1# = now# + 500
  fightCooldown2# = now# + 1200
  fightWinner# = 0
  fightStart# = now#
  fightHitTimer1# = 0
  fightHitTimer2# = 0
  fightPunchTimer1# = 0
  fightPunchTimer2# = 0
  fightEndTimer# = 0

  ' Store fight center for bobbing movement
  fightCenterX# = (pX@[fightP1#] + pX@[fightP2#]) / 2
  fightCenterY# = (pY@[fightP1#] + pY@[fightP2#]) / 2

  ' Position fighters facing each other (bodies separate, punches connect)
  pX@[fightP1#] = fightCenterX# - 14
  pX@[fightP2#] = fightCenterX# + 14
  pY@[fightP1#] = fightCenterY#
  pY@[fightP2#] = fightCenterY#
  pDir@[fightP1#] = 1
  pDir@[fightP2#] = -1

  ' Stop all players
  FOR i# FROM 1 TO NUM_PLAYERS#
    pVX@[i#] = 0
    pVY@[i#] = 0
  END FOR

  ' Drop puck at fight location
  IF puckOwner# > 0 THEN
    pHasPuck@[puckOwner#] = 0
    puckOwner# = 0
    puckLoose? = YES
  END IF
  puckX# = fightCenterX#
  puckY# = fightCenterY# + 30
  puckVX# = 0
  puckVY# = 0

  ' Clear stun on fighters and set idle pose
  pState@[fightP1#] = 0
  pState@[fightP2#] = 0
  pAnim@[fightP1#] = ANIM_SKATE#
  pAnimFrame@[fightP1#] = 2
  pAnim@[fightP2#] = ANIM_SKATE#
  pAnimFrame@[fightP2#] = 2

  ' Camera follows Whaler fighter
  activeP# = fightP1#

  gameState# = STATE_FIGHT#
END FUNCTION

FUNCTION updateFight
  elapsed# = now# - fightStart#

  ' KO decided — hold the knockdown pose, then end
  IF fightWinner# > 0 THEN
    IF now# - fightEndTimer# > 800 THEN
      endFight
    END IF
    RETURN
  END IF

  ' === Fighter movement: bob back and forth ===
  bobPhase1# = SIN# VALUE (elapsed# * 0.004) * 3
  bobPhase2# = SIN# VALUE (elapsed# * 0.0035 + 1.5) * 3

  ' Recoil when hit (push away from opponent)
  recoil1# = 0
  recoil2# = 0
  IF fightHitTimer1# > 0 THEN
    hitAge1# = now# - fightHitTimer1#
    IF hitAge1# < 300 THEN
      recoil1# = (300 - hitAge1#) / 300 * -5
    END IF
  END IF
  IF fightHitTimer2# > 0 THEN
    hitAge2# = now# - fightHitTimer2#
    IF hitAge2# < 300 THEN
      recoil2# = (300 - hitAge2#) / 300 * 5
    END IF
  END IF

  ' Lunge forward when punching (arm reaches opponent's body)
  lunge1# = 0
  lunge2# = 0
  IF fightPunchTimer1# > 0 AND now# - fightPunchTimer1# < 200 THEN
    lunge1# = 8
  END IF
  IF fightPunchTimer2# > 0 AND now# - fightPunchTimer2# < 200 THEN
    lunge2# = -8
  END IF

  pX@[fightP1#] = fightCenterX# - 14 + bobPhase1# + recoil1# + lunge1#
  pX@[fightP2#] = fightCenterX# + 14 + bobPhase2# + recoil2# + lunge2#

  ' Always face opponent
  IF pX@[fightP2#] > pX@[fightP1#] THEN
    pDir@[fightP1#] = 1
    pDir@[fightP2#] = -1
  ELSE
    pDir@[fightP1#] = -1
    pDir@[fightP2#] = 1
  END IF

  ' === Player punches (Z button, with cooldown) ===
  IF inputShoot? AND now# > fightCooldown1# THEN
    rIdx# = pRoster@[fightP1#]
    punchPower# = wFight@[rIdx#] * 2 + 5
    fightHP2# = fightHP2# - punchPower#
    fightCooldown1# = now# + FIGHT_PUNCH_COOLDOWN#
    fightPunchTimer1# = now#
    fightHitTimer2# = now#

    PLAY "T200 L32 O3 C", BACKGROUND YES
  END IF

  ' === AI punches (slower baseline, faster with better stat) ===
  oRIdx# = pRoster@[fightP2#]
  aiPunchInterval# = 1800 - oFight@[oRIdx#] * 80
  IF aiPunchInterval# < 700 THEN
    aiPunchInterval# = 700
  END IF

  IF now# > fightCooldown2# THEN
    punchPower# = oFight@[oRIdx#] * 2 + 5
    fightHP1# = fightHP1# - punchPower#
    fightCooldown2# = now# + aiPunchInterval#
    fightPunchTimer2# = now#
    fightHitTimer1# = now#

    PLAY "T200 L32 O3 D", BACKGROUND YES
  END IF

  ' === Fighter animations (priority: stagger > punch > idle) ===
  ' Stagger = skate frame 3 (not full knockdown), punch = shoot frame 2
  IF fightHitTimer1# > 0 AND now# - fightHitTimer1# < 300 THEN
    pAnim@[fightP1#] = ANIM_SKATE#
    pAnimFrame@[fightP1#] = 3
  ELSE IF fightPunchTimer1# > 0 AND now# - fightPunchTimer1# < 200 THEN
    pAnim@[fightP1#] = ANIM_SHOOT#
    pAnimFrame@[fightP1#] = 2
  ELSE
    pAnim@[fightP1#] = ANIM_SKATE#
    pAnimFrame@[fightP1#] = 2
  END IF

  IF fightHitTimer2# > 0 AND now# - fightHitTimer2# < 300 THEN
    pAnim@[fightP2#] = ANIM_SKATE#
    pAnimFrame@[fightP2#] = 3
  ELSE IF fightPunchTimer2# > 0 AND now# - fightPunchTimer2# < 200 THEN
    pAnim@[fightP2#] = ANIM_SHOOT#
    pAnimFrame@[fightP2#] = 2
  ELSE
    pAnim@[fightP2#] = ANIM_SKATE#
    pAnimFrame@[fightP2#] = 2
  END IF

  ' Clamp HP
  IF fightHP1# < 0 THEN
    fightHP1# = 0
  END IF
  IF fightHP2# < 0 THEN
    fightHP2# = 0
  END IF

  ' Check for KO or timeout
  IF fightHP1# <= 0 THEN
    fightWinner# = 2
  ELSE IF fightHP2# <= 0 THEN
    fightWinner# = 1
  ELSE IF elapsed# > FIGHT_DURATION# THEN
    IF fightHP1# >= fightHP2# THEN
      fightWinner# = 1
    ELSE
      fightWinner# = 2
    END IF
  END IF

  ' When winner decided, set KO pose on loser + sad trombone
  IF fightWinner# > 0 THEN
    fightEndTimer# = now#
    PLAY "T180 L8 O3 B L8 B- L8 A L4 A-", BACKGROUND YES
    IF fightWinner# = 1 THEN
      pAnim@[fightP2#] = ANIM_KNOCKED#
      pAnimFrame@[fightP2#] = 1
      pAnim@[fightP1#] = ANIM_SKATE#
      pAnimFrame@[fightP1#] = 2
    ELSE
      pAnim@[fightP1#] = ANIM_KNOCKED#
      pAnimFrame@[fightP1#] = 1
      pAnim@[fightP2#] = ANIM_SKATE#
      pAnimFrame@[fightP2#] = 2
    END IF
  END IF
END FUNCTION

FUNCTION endFight
  ' Reset fighter states
  pState@[fightP1#] = 0
  pState@[fightP2#] = 0
  pAnim@[fightP1#] = ANIM_SKATE#
  pAnimFrame@[fightP1#] = 2
  pAnim@[fightP2#] = ANIM_SKATE#
  pAnimFrame@[fightP2#] = 2

  ' Faceoff at nearest dot
  shotCharging? = NO
  passInFlight? = NO
  setNearestFaceoffDot
  setupFaceoff
  gameState# = STATE_FACEOFF#
END FUNCTION

FUNCTION drawFight
  ' Header text
  IF fightWinner# = 1 THEN
    SETCOLOR GREEN&
    PRINTAT 3, 34, "YOU WIN!"
  ELSE IF fightWinner# = 2 THEN
    SETCOLOR RED&
    PRINTAT 3, 33, "YOU LOSE!"
  ELSE
    SETCOLOR RED&
    PRINTAT 3, 35, "FIGHT!"
  END IF

  ' Health bars — fixed screen positions, spread apart
  barW# = 120
  barH# = 10
  barY# = 10

  ' Whaler health bar (left side of screen)
  SETCOLOR DARKGRAY&
  DRAWBOX X1 40, Y1 barY#, X2 (40 + barW#), Y2 (barY# + barH#), FILL YES
  SETCOLOR GREEN&
  fillW# = barW# * fightHP1# / 100
  IF fillW# > 0 THEN
    DRAWBOX X1 40, Y1 barY#, X2 (40 + fillW#), Y2 (barY# + barH#), FILL YES
  END IF
  SETCOLOR WHITE&
  PRINTAT 1, 2, "WHR"

  ' Opponent health bar (right side of screen)
  SETCOLOR DARKGRAY&
  DRAWBOX X1 (640 - 40 - barW#), Y1 barY#, X2 (640 - 40), Y2 (barY# + barH#), FILL YES
  SETCOLOR RED&
  fillW# = barW# * fightHP2# / 100
  IF fillW# > 0 THEN
    DRAWBOX X1 (640 - 40 - barW#), Y1 barY#, X2 (640 - 40 - barW# + fillW#), Y2 (barY# + barH#), FILL YES
  END IF
  SETCOLOR WHITE&
  PRINTAT 1, 76, "OPP"

  ' Controls hint
  IF fightWinner# = 0 THEN
    PRINTAT 4, 33, "Z = PUNCH"
  END IF
END FUNCTION

' ============ MAIN LOOP ============
BUFFERENABLED YES
running? = YES

' Start with a faceoff
setupFaceoff

WHILE running?
  now# = RUNNINGTIME#

  ' Input (always read)
  handleInput

  IF gameState# = STATE_FACEOFF# THEN
    updateFaceoff
    updateCamera

    CLEARBUFFER
    drawRink
    drawPlayers
    drawPuck
    drawScore

  ELSE IF gameState# = STATE_PLAY# THEN
    handleShooting
    handlePassing
    handleChecking

    moveActivePlayer
    updateTeammateAI
    updateOpponentAI
    updateGoalieAI
    updatePlayerPhysics

    updatePuck
    handleOpponentChecking
    checkGoals
    updateClock

    updateAnimations
    updateCamera

    CLEARBUFFER
    drawRink
    drawPlayers
    drawPuck
    drawScore

  ELSE IF gameState# = STATE_GOAL# THEN
    updateGoalCelly
    updateCamera

    CLEARBUFFER
    drawRink
    drawPlayers
    drawPuck
    drawScore
    drawGoalCelly

  ELSE IF gameState# = STATE_FIGHT# THEN
    updateFight
    updateCamera

    CLEARBUFFER
    drawRink
    drawPlayers
    drawPuck
    drawScore
    drawFight

  ELSE IF gameState# = STATE_PERIOD_END# THEN
    updatePeriodEnd

    CLEARBUFFER
    drawPeriodEnd
    drawScore

  ELSE IF gameState# = STATE_GAME_OVER# THEN
    CLEARBUFFER
    drawGameOver
    drawScore
  END IF

  SHOWBUFFER
  SLEEP 0.016
END WHILE
