' Puck physics
puckVX# = 0
puckVY# = 0
puckFreezeUntil# = 0

' Shooting state
shotCharging? = NO
shotChargeStart# = 0

' Passing state
passInFlight? = NO
passTime# = 0

' Score and game state
scoreW# = 0
scoreO# = 0
now# = 0

' Shot stats per roster slot (1-10)
wShot@ = [7, 8, 6]
oShot@ = [6, 5, 7]

' Check stats per roster slot (1-10)
wCheck@ = [6, 5, 8]
oCheck@ = [5, 6, 7]

' Fight stats per roster slot (1-10)
wFight@ = [6, 4, 8]
oFight@ = [5, 6, 7]

' Check cooldown
checkCooldown# = 0

' Goalie hold timer (when goalie picked up puck)
goalieHoldTime# = 0

' Game state
gameState# = STATE_PLAY#

' Fight state
fightP1# = 0
fightP2# = 0
fightStart# = 0
fightHP1# = 0
fightHP2# = 0
fightCooldown1# = 0
fightCooldown2# = 0
fightWinner# = 0
fightHitTimer1# = 0
fightHitTimer2# = 0
fightPunchTimer1# = 0
fightPunchTimer2# = 0
fightCenterX# = 0
fightCenterY# = 0
fightEndTimer# = 0

' Initial positions (center-ice faceoff)
' Whalers (left side): C at faceoff, wings spread, goalie in net
pX@[1] = 590
pY@[1] = 240
pDir@[1] = 1
pX@[2] = 500
pY@[2] = 160
pDir@[2] = 1
pX@[3] = 500
pY@[3] = 320
pDir@[3] = 1
pX@[4] = 80
pY@[4] = 240
pDir@[4] = 1

' Opponent (right side)
pX@[5] = 610
pY@[5] = 240
pDir@[5] = -1
pX@[6] = 700
pY@[6] = 160
pDir@[6] = -1
pX@[7] = 700
pY@[7] = 320
pDir@[7] = -1
pX@[8] = 1120
pY@[8] = 240
pDir@[8] = -1

' ============ FUNCTIONS ============

FUNCTION updateCamera
  ' Target: center active player horizontally on screen
  targetCamX# = pX@[activeP#] - SCREEN_W# / 2

  ' Clamp to rink bounds
  targetCamX# = MAX# A targetCamX#, B 0
  targetCamX# = MIN# A targetCamX#, B (RINK_W# - SCREEN_W#)

  ' Smooth follow (lerp)
  camX# = camX# + (targetCamX# - camX#) * 0.08
END FUNCTION

FUNCTION collidePuck
  ' Straight wall clamping
  puckX# = MAX# A puckX#, B ICE_LEFT#
  puckX# = MIN# A puckX#, B ICE_RIGHT#
  puckY# = MAX# A puckY#, B ICE_TOP#
  puckY# = MIN# A puckY#, B ICE_BOTTOM#

  ' Corner circle centers
  cLeftX# = ICE_LEFT# + ICE_CORNER_R#
  cRightX# = ICE_RIGHT# - ICE_CORNER_R#
  cTopY# = ICE_TOP# + ICE_CORNER_R#
  cBotY# = ICE_BOTTOM# - ICE_CORNER_R#

  ' Top-left corner
  IF puckX# < cLeftX# AND puckY# < cTopY# THEN
    dx# = puckX# - cLeftX#
    dy# = puckY# - cTopY#
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)
    IF dist# > ICE_CORNER_R# THEN
      puckX# = cLeftX# + dx# / dist# * ICE_CORNER_R#
      puckY# = cTopY# + dy# / dist# * ICE_CORNER_R#
    END IF
  END IF

  ' Top-right corner
  IF puckX# > cRightX# AND puckY# < cTopY# THEN
    dx# = puckX# - cRightX#
    dy# = puckY# - cTopY#
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)
    IF dist# > ICE_CORNER_R# THEN
      puckX# = cRightX# + dx# / dist# * ICE_CORNER_R#
      puckY# = cTopY# + dy# / dist# * ICE_CORNER_R#
    END IF
  END IF

  ' Bottom-left corner
  IF puckX# < cLeftX# AND puckY# > cBotY# THEN
    dx# = puckX# - cLeftX#
    dy# = puckY# - cBotY#
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)
    IF dist# > ICE_CORNER_R# THEN
      puckX# = cLeftX# + dx# / dist# * ICE_CORNER_R#
      puckY# = cBotY# + dy# / dist# * ICE_CORNER_R#
    END IF
  END IF

  ' Bottom-right corner
  IF puckX# > cRightX# AND puckY# > cBotY# THEN
    dx# = puckX# - cRightX#
    dy# = puckY# - cBotY#
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)
    IF dist# > ICE_CORNER_R# THEN
      puckX# = cRightX# + dx# / dist# * ICE_CORNER_R#
      puckY# = cBotY# + dy# / dist# * ICE_CORNER_R#
    END IF
  END IF
END FUNCTION

FUNCTION drawRink
  ' Boards (dark gray rounded rectangle)
  SETCOLOR DARKGRAY&
  bx1# = 0 - camX#
  by1# = RINK_TOP#
  bx2# = RINK_W# - camX#
  by2# = RINK_TOP# + RINK_H#
  DRAWBOX X1 (bx1# + CORNER_R#), Y1 by1#, X2 (bx2# - CORNER_R#), Y2 by2#, FILL YES
  DRAWBOX X1 bx1#, Y1 (by1# + CORNER_R#), X2 bx2#, Y2 (by2# - CORNER_R#), FILL YES
  DRAWCIRCLE X (bx1# + CORNER_R#), Y (by1# + CORNER_R#), RADIUS CORNER_R#, FILL YES
  DRAWCIRCLE X (bx2# - CORNER_R#), Y (by1# + CORNER_R#), RADIUS CORNER_R#, FILL YES
  DRAWCIRCLE X (bx1# + CORNER_R#), Y (by2# - CORNER_R#), RADIUS CORNER_R#, FILL YES
  DRAWCIRCLE X (bx2# - CORNER_R#), Y (by2# - CORNER_R#), RADIUS CORNER_R#, FILL YES

  ' Player benches (top side, between blue lines)
  ' Home bench (left of center)
  SETCOLOR BENCH_COLOR&
  DRAWBOX X1 (BENCH_LEFT_X1# - camX#), Y1 BENCH_Y1#, X2 (BENCH_LEFT_X2# - camX#), Y2 BENCH_Y2#, FILL YES
  SETCOLOR BENCH_SEAT_COLOR&
  DRAWBOX X1 (BENCH_LEFT_X1# + 3 - camX#), Y1 (BENCH_Y1# + 3), X2 (BENCH_LEFT_X2# - 3 - camX#), Y2 (BENCH_Y2# - 3), FILL YES
  ' Away bench (right of center)
  SETCOLOR BENCH_COLOR&
  DRAWBOX X1 (BENCH_RIGHT_X1# - camX#), Y1 BENCH_Y1#, X2 (BENCH_RIGHT_X2# - camX#), Y2 BENCH_Y2#, FILL YES
  SETCOLOR BENCH_SEAT_COLOR&
  DRAWBOX X1 (BENCH_RIGHT_X1# + 3 - camX#), Y1 (BENCH_Y1# + 3), X2 (BENCH_RIGHT_X2# - 3 - camX#), Y2 (BENCH_Y2# - 3), FILL YES

  ' Bench players (drawn before ice so boards cover their lower half)
  benchY# = 24
  FOR bp# FROM 0 TO 4
    ' Home bench — Whalers
    bpx# = 459 + bp# * 26 - camX#
    IF bpx# > -40 AND bpx# < 680 THEN
      DRAWSPRITE SPRITE wSkate@[2], X bpx#, Y benchY#, SCALE 2
    END IF
    ' Away bench — Opponents
    bpx# = 609 + bp# * 26 - camX#
    IF bpx# > -40 AND bpx# < 680 THEN
      DRAWSPRITE SPRITE oSkate@[2], X bpx#, Y benchY#, SCALE 2
    END IF
  END FOR

  ' Ice surface (white rounded rectangle)
  SETCOLOR WHITE&
  ix1# = ICE_LEFT# - camX#
  iy1# = ICE_TOP#
  ix2# = ICE_RIGHT# - camX#
  iy2# = ICE_BOTTOM#
  DRAWBOX X1 (ix1# + ICE_CORNER_R#), Y1 iy1#, X2 (ix2# - ICE_CORNER_R#), Y2 iy2#, FILL YES
  DRAWBOX X1 ix1#, Y1 (iy1# + ICE_CORNER_R#), X2 ix2#, Y2 (iy2# - ICE_CORNER_R#), FILL YES
  DRAWCIRCLE X (ix1# + ICE_CORNER_R#), Y (iy1# + ICE_CORNER_R#), RADIUS ICE_CORNER_R#, FILL YES
  DRAWCIRCLE X (ix2# - ICE_CORNER_R#), Y (iy1# + ICE_CORNER_R#), RADIUS ICE_CORNER_R#, FILL YES
  DRAWCIRCLE X (ix1# + ICE_CORNER_R#), Y (iy2# - ICE_CORNER_R#), RADIUS ICE_CORNER_R#, FILL YES
  DRAWCIRCLE X (ix2# - ICE_CORNER_R#), Y (iy2# - ICE_CORNER_R#), RADIUS ICE_CORNER_R#, FILL YES

  ' Goal lines (thin red)
  SETCOLOR RED&
  DRAWLINE X1 (GOAL_LEFT_X# - camX#), Y1 ICE_TOP#, X2 (GOAL_LEFT_X# - camX#), Y2 ICE_BOTTOM#
  DRAWLINE X1 (GOAL_RIGHT_X# - camX#), Y1 ICE_TOP#, X2 (GOAL_RIGHT_X# - camX#), Y2 ICE_BOTTOM#

  ' Center red line (thick)
  lx# = CENTER_X# - camX#
  DRAWBOX X1 (lx# - LINE_HALF#), Y1 ICE_TOP#, X2 (lx# + LINE_HALF#), Y2 ICE_BOTTOM#, FILL YES

  ' Blue lines (thick)
  SETCOLOR BLUE&
  lx# = BLUE_LEFT_X# - camX#
  DRAWBOX X1 (lx# - LINE_HALF#), Y1 ICE_TOP#, X2 (lx# + LINE_HALF#), Y2 ICE_BOTTOM#, FILL YES
  lx# = BLUE_RIGHT_X# - camX#
  DRAWBOX X1 (lx# - LINE_HALF#), Y1 ICE_TOP#, X2 (lx# + LINE_HALF#), Y2 ICE_BOTTOM#, FILL YES

  ' Center circle and dot
  SETCOLOR RED&
  cx# = CENTER_X# - camX#
  cy# = 240
  DRAWCIRCLE X cx#, Y cy#, RADIUS 60, FILL NO
  DRAWCIRCLE X cx#, Y cy#, RADIUS 3, FILL YES

  ' Faceoff circles and dots (4 zone dots)
  DRAWCIRCLE X (200 - camX#), Y 150, RADIUS 60, FILL NO
  DRAWCIRCLE X (200 - camX#), Y 330, RADIUS 60, FILL NO
  DRAWCIRCLE X (1000 - camX#), Y 150, RADIUS 60, FILL NO
  DRAWCIRCLE X (1000 - camX#), Y 330, RADIUS 60, FILL NO
  DRAWCIRCLE X (200 - camX#), Y 150, RADIUS 3, FILL YES
  DRAWCIRCLE X (200 - camX#), Y 330, RADIUS 3, FILL YES
  DRAWCIRCLE X (1000 - camX#), Y 150, RADIUS 3, FILL YES
  DRAWCIRCLE X (1000 - camX#), Y 330, RADIUS 3, FILL YES

  ' Neutral zone faceoff dots (beside each blue line)
  DRAWCIRCLE X (470 - camX#), Y 150, RADIUS 3, FILL YES
  DRAWCIRCLE X (470 - camX#), Y 330, RADIUS 3, FILL YES
  DRAWCIRCLE X (730 - camX#), Y 150, RADIUS 3, FILL YES
  DRAWCIRCLE X (730 - camX#), Y 330, RADIUS 3, FILL YES

  ' Goal creases (filled light blue semicircles)
  ' Left crease: filled circle + white box to mask left half
  SETCOLOR CREASE_COLOR&
  DRAWCIRCLE X (GOAL_LEFT_X# - camX#), Y 240, RADIUS 25, FILL YES
  SETCOLOR WHITE&
  DRAWBOX X1 (GOAL_LEFT_X# - 26 - camX#), Y1 214, X2 (GOAL_LEFT_X# - camX#), Y2 266, FILL YES
  ' Right crease: filled circle + white box to mask right half
  SETCOLOR CREASE_COLOR&
  DRAWCIRCLE X (GOAL_RIGHT_X# - camX#), Y 240, RADIUS 25, FILL YES
  SETCOLOR WHITE&
  DRAWBOX X1 (GOAL_RIGHT_X# - camX#), Y1 214, X2 (GOAL_RIGHT_X# + 26 - camX#), Y2 266, FILL YES

  ' Goal nets
  SETCOLOR RED&
  DRAWBOX X1 (GOAL_LEFT_X# - GOAL_W# - camX#), Y1 (240 - GOAL_H# / 2), X2 (GOAL_LEFT_X# - camX#), Y2 (240 + GOAL_H# / 2), FILL NO
  DRAWBOX X1 (GOAL_RIGHT_X# - camX#), Y1 (240 - GOAL_H# / 2), X2 (GOAL_RIGHT_X# + GOAL_W# - camX#), Y2 (240 + GOAL_H# / 2), FILL NO

END FUNCTION

FUNCTION updateAnimations
  FOR i# FROM 1 TO 8
    pAnimTimer@[i#] = pAnimTimer@[i#] + 1
    anim# = pAnim@[i#]

    IF anim# = ANIM_SKATE# THEN
      IF pPushing@[i#] = 1 THEN
        IF pAnimTimer@[i#] >= SKATE_FRAME_TIME# THEN
          pAnimTimer@[i#] = 0
          pAnimFrame@[i#] = pAnimFrame@[i#] + 1
          IF pAnimFrame@[i#] > 3 THEN
            pAnimFrame@[i#] = 1
          END IF
        END IF
      ELSE
        pAnimFrame@[i#] = 2
        pAnimTimer@[i#] = 0
      END IF
    ELSE IF anim# = ANIM_SHOOT# THEN
      IF pAnimTimer@[i#] >= SHOOT_FRAME_TIME# THEN
        pAnimTimer@[i#] = 0
        pAnimFrame@[i#] = pAnimFrame@[i#] + 1
        IF pAnimFrame@[i#] > 3 THEN
          pAnimFrame@[i#] = 1
          pAnim@[i#] = ANIM_SKATE#
        END IF
      END IF
    ELSE IF anim# = ANIM_GOALIE_GLOVE# OR anim# = ANIM_GOALIE_BLOCKER# OR anim# = ANIM_GOALIE_SPLIT# THEN
      IF pAnimTimer@[i#] >= GOALIE_FRAME_TIME# THEN
        pAnimTimer@[i#] = 0
        pAnimFrame@[i#] = pAnimFrame@[i#] + 1
        IF pAnimFrame@[i#] > 2 THEN
          pAnimFrame@[i#] = 1
          pAnim@[i#] = ANIM_GOALIE_IDLE#
        END IF
      END IF
    END IF
  END FOR
END FUNCTION

FUNCTION getPlayerSprite# IDX idx#
  anim# = pAnim@[idx#]
  frame# = pAnimFrame@[idx#]
  isWhalers? = (idx# <= 4)

  IF anim# = ANIM_SKATE# THEN
    IF isWhalers? THEN
      result# = wSkate@[frame#]
    ELSE
      result# = oSkate@[frame#]
    END IF
  ELSE IF anim# = ANIM_SHOOT# THEN
    IF isWhalers? THEN
      result# = wShoot@[frame#]
    ELSE
      result# = oShoot@[frame#]
    END IF
  ELSE IF anim# = ANIM_GOALIE_IDLE# THEN
    IF isWhalers? THEN
      result# = wGoalieId#
    ELSE
      result# = oGoalieId#
    END IF
  ELSE IF anim# = ANIM_GOALIE_GLOVE# THEN
    IF isWhalers? THEN
      result# = wGoalieGlove@[frame#]
    ELSE
      result# = oGoalieGlove@[frame#]
    END IF
  ELSE IF anim# = ANIM_GOALIE_BLOCKER# THEN
    IF isWhalers? THEN
      result# = wGoalieBlocker@[frame#]
    ELSE
      result# = oGoalieBlocker@[frame#]
    END IF
  ELSE IF anim# = ANIM_GOALIE_SPLIT# THEN
    IF isWhalers? THEN
      result# = wGoalieSplit@[frame#]
    ELSE
      result# = oGoalieSplit@[frame#]
    END IF
  ELSE IF anim# = ANIM_KNOCKED# THEN
    IF isWhalers? THEN
      result# = wKnockedId#
    ELSE
      result# = oKnockedId#
    END IF
  END IF

  RETURN result#
END FUNCTION

FUNCTION drawPlayers
  ' Sort by Y for depth (bubble sort, only 8 elements)
  sortOrder@ = [1, 2, 3, 4, 5, 6, 7, 8]
  FOR i# FROM 1 TO 7
    FOR j# FROM 1 TO 8 - i#
      IF pY@[sortOrder@[j#]] > pY@[sortOrder@[j# + 1]] THEN
        temp# = sortOrder@[j#]
        sortOrder@[j#] = sortOrder@[j# + 1]
        sortOrder@[j# + 1] = temp#
      END IF
    END FOR
  END FOR

  FOR i# FROM 1 TO 8
    idx# = sortOrder@[i#]
    sx# = pX@[idx#] - camX#
    sy# = pY@[idx#]

    ' Skip if off screen
    IF sx# < -30 OR sx# > 670 THEN
      CONTINUE
    END IF

    ' Pick sprite based on team, position, and animation state
    sprId# = getPlayerSprite# IDX idx#

    ' Flip if facing left
    flip? = NO
    IF pDir@[idx#] = -1 THEN
      flip? = YES
    END IF

    ' Active player indicator
    IF idx# = activeP# THEN
      sprW# = SPRITEWIDTH# SPRITE sprId#
      SETCOLOR INDICATOR_COLOR&
      DRAWCIRCLE X (sx# + sprW# * PLAYER_SCALE# / 2), Y (sy# + 17 * PLAYER_SCALE#), RADIUS 18, FILL YES
    END IF

    ' Draw player
    DRAWSPRITE SPRITE sprId#, X sx#, Y sy#, SCALE PLAYER_SCALE#, FLIPH flip?

    ' Draw stick (skaters only, not goalies, knocked-down, or fighters)
    IF idx# <> 4 AND idx# <> 8 AND pAnim@[idx#] <> ANIM_KNOCKED# AND NOT (gameState# = STATE_FIGHT# AND (idx# = fightP1# OR idx# = fightP2#)) THEN
      SETCOLOR BROWN&
      IF pDir@[idx#] = 1 THEN
        shX# = sx# + 11 * PLAYER_SCALE#
        shY# = sy# + 10 * PLAYER_SCALE#
        stX# = sx# + 14 * PLAYER_SCALE#
        stY# = sy# + 13 * PLAYER_SCALE#
      ELSE
        shX# = sx# + 5 * PLAYER_SCALE#
        shY# = sy# + 10 * PLAYER_SCALE#
        stX# = sx# - 2 * PLAYER_SCALE#
        stY# = sy# + 13 * PLAYER_SCALE#
      END IF
      DRAWLINE X1 shX#, Y1 shY#, X2 stX#, Y2 stY#
      IF pDir@[idx#] = 1 THEN
        DRAWLINE X1 stX#, Y1 stY#, X2 (stX# + 2 * PLAYER_SCALE#), Y2 stY#
      ELSE
        DRAWLINE X1 stX#, Y1 stY#, X2 (stX# - 2 * PLAYER_SCALE#), Y2 stY#
      END IF
    END IF
  END FOR
END FUNCTION

FUNCTION drawPuck
  sx# = puckX# - camX#
  IF sx# > -10 AND sx# < 650 THEN
    DRAWSPRITE SPRITE puckSprId#, X sx#, Y puckY#, SCALE PUCK_SCALE#
  END IF
END FUNCTION

FUNCTION drawScore
  ' Display score at bottom of screen
  SETCOLOR WHITE&
  PRINTAT 25, 30, "WHR"
  PRINTAT 25, 34, scoreW#
  PRINTAT 25, 36, "-"
  PRINTAT 25, 38, scoreO#
  PRINTAT 25, 40, "OPP"
END FUNCTION

FUNCTION handleInput
  keys@ = GETALLKEYS@
  inputX# = 0
  inputY# = 0
  inputShoot? = NO
  inputPass? = NO
  FOR ki# FROM 1 TO LENGTH# keys@
    k$ = keys@[ki#]
    IF k$ = "ArrowLeft" THEN
      inputX# = -1
    END IF
    IF k$ = "ArrowRight" THEN
      inputX# = 1
    END IF
    IF k$ = "ArrowUp" THEN
      inputY# = -1
    END IF
    IF k$ = "ArrowDown" THEN
      inputY# = 1
    END IF
    IF k$ = "z" OR k$ = "Z" THEN
      inputShoot? = YES
    END IF
    IF k$ = "x" OR k$ = "X" THEN
      inputPass? = YES
    END IF
  END FOR

  ' Edge detect pass button (fire once per press)
  passPressed? = NO
  IF inputPass? AND NOT prevPass? THEN
    passPressed? = YES
  END IF
  prevPass? = inputPass?
END FUNCTION

FUNCTION moveActivePlayer
  IF pState@[activeP#] = 2 THEN
    RETURN
  END IF

  rIdx# = pRoster@[activeP#]
  spd# = wSpeed@[rIdx#] * 0.4 + 2

  IF inputX# <> 0 OR inputY# <> 0 THEN
    pPushing@[activeP#] = 1

    ' Normalize diagonal
    IF inputX# <> 0 AND inputY# <> 0 THEN
      spd# = spd# * 0.707
    END IF
    pVX@[activeP#] = pVX@[activeP#] + inputX# * spd# * 0.3
    pVY@[activeP#] = pVY@[activeP#] + inputY# * spd# * 0.3

    ' Update facing direction
    IF inputX# <> 0 THEN
      pDir@[activeP#] = inputX#
    END IF
  ELSE
    pPushing@[activeP#] = 0
  END IF
END FUNCTION

FUNCTION updatePlayerPhysics
  FOR i# FROM 1 TO NUM_PLAYERS#
    ' Apply friction
    pVX@[i#] = pVX@[i#] * PLAYER_FRICTION#
    pVY@[i#] = pVY@[i#] * PLAYER_FRICTION#

    ' Clamp small velocities to zero
    IF ABS# VALUE pVX@[i#] < 0.1 THEN
      pVX@[i#] = 0
    END IF
    IF ABS# VALUE pVY@[i#] < 0.1 THEN
      pVY@[i#] = 0
    END IF

    ' Clamp to max speed
    pSpd# = SQRT# VALUE (pVX@[i#] * pVX@[i#] + pVY@[i#] * pVY@[i#])
    IF pSpd# > PLAYER_MAX_SPEED# THEN
      pVX@[i#] = pVX@[i#] / pSpd# * PLAYER_MAX_SPEED#
      pVY@[i#] = pVY@[i#] / pSpd# * PLAYER_MAX_SPEED#
    END IF

    ' Update position
    pX@[i#] = pX@[i#] + pVX@[i#]
    pY@[i#] = pY@[i#] + pVY@[i#]

    ' Clamp to ice bounds (goalies handled separately)
    IF i# = 4 OR i# = 8 THEN
      ' Goalie bounds — skip for now
    ELSE
      pX@[i#] = MAX# A pX@[i#], B ICE_LEFT#
      pX@[i#] = MIN# A pX@[i#], B (ICE_RIGHT# - 24)
      pY@[i#] = MAX# A pY@[i#], B ICE_TOP#
      pY@[i#] = MIN# A pY@[i#], B (ICE_BOTTOM# - 32)
    END IF

    ' Board bounce
    IF pX@[i#] <= ICE_LEFT# OR pX@[i#] >= (ICE_RIGHT# - 24) THEN
      pVX@[i#] = pVX@[i#] * -0.3
    END IF
    IF pY@[i#] <= ICE_TOP# OR pY@[i#] >= (ICE_BOTTOM# - 32) THEN
      pVY@[i#] = pVY@[i#] * -0.3
    END IF

    ' Update stun timer
    IF pState@[i#] = 2 THEN
      IF now# - pStateT@[i#] > STUN_DURATION# THEN
        pState@[i#] = 0
        pAnim@[i#] = ANIM_SKATE#
        pAnimFrame@[i#] = 2
        pAnimTimer@[i#] = 0
      END IF
    END IF
  END FOR
END FUNCTION

FUNCTION switchActivePlayer
  ' Only switch if no Whaler has puck (X = pass when Whaler has puck)
  IF puckOwner# >= 1 AND puckOwner# <= 3 THEN
    RETURN
  END IF

  bestDist# = 99999
  bestP# = activeP#

  FOR i# FROM 1 TO 3
    IF pState@[i#] = 2 THEN
      CONTINUE
    END IF
    dx# = pX@[i#] - puckX#
    dy# = pY@[i#] - puckY#
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)
    IF dist# < bestDist# THEN
      bestDist# = dist#
      bestP# = i#
    END IF
  END FOR

  activeP# = bestP#
END FUNCTION

FUNCTION updateTeammateAI
  FOR i# FROM 1 TO 3
    IF i# = activeP# THEN
      CONTINUE
    END IF
    IF pState@[i#] = 2 THEN
      CONTINUE
    END IF

    rIdx# = pRoster@[i#]
    spd# = wSpeed@[rIdx#] * 0.3 + 1.5
    pushStr# = 0.2
    targetX# = pX@[i#]
    targetY# = pY@[i#]

    ' If a pass is in flight, skate toward where the puck will be
    IF passInFlight? AND puckOwner# = 0 THEN
      targetX# = puckX# + puckVX# * 3
      targetY# = puckY# + puckVY# * 3
      pushStr# = 0.3

    ' If puck is loose, closest non-active Whaler chases it
    ELSE IF puckLoose? AND puckOwner# = 0 THEN
      closestW# = 0
      closestWD# = 99999
      FOR ci# FROM 1 TO 3
        IF ci# = activeP# OR pState@[ci#] = 2 THEN
          CONTINUE
        END IF
        cdx# = pX@[ci#] - puckX#
        cdy# = pY@[ci#] - puckY#
        cd# = SQRT# VALUE (cdx# * cdx# + cdy# * cdy#)
        IF cd# < closestWD# THEN
          closestWD# = cd#
          closestW# = ci#
        END IF
      END FOR
      IF i# = closestW# THEN
        targetX# = puckX#
        targetY# = puckY#
        pushStr# = 0.3
      ELSE
        ' Not closest — defend
        defX# = puckX# - 80
        IF defX# < GOAL_LEFT_X# + 60 THEN
          defX# = GOAL_LEFT_X# + 60
        END IF
        IF i# = 1 THEN
          targetX# = defX#
          targetY# = puckY# - 60
        ELSE IF i# = 2 THEN
          targetX# = defX#
          targetY# = puckY# + 60
        ELSE
          targetX# = defX# + 40
          targetY# = puckY#
        END IF
      END IF

    ' Active player or teammate has the puck — get open for a pass
    ELSE IF puckOwner# >= 1 AND puckOwner# <= 3 THEN
      carrierX# = pX@[puckOwner#]

      ' Spread out: skate ahead of the carrier toward opponent goal
      IF i# = 1 THEN
        laneY# = 150
      ELSE IF i# = 2 THEN
        laneY# = 330
      ELSE
        laneY# = 240
      END IF

      targetX# = carrierX# + 100 + RANDOM# MAX 40
      targetY# = laneY# + SIN# VALUE (now# * 0.002 + i# * 2) * 40

      ' Stay away from opponents (find nearest and nudge away)
      nearOppDist# = 99999
      nearOppY# = targetY#
      FOR oi# FROM 5 TO 7
        ox# = pX@[oi#] - targetX#
        oy# = pY@[oi#] - targetY#
        od# = SQRT# VALUE (ox# * ox# + oy# * oy#)
        IF od# < nearOppDist# THEN
          nearOppDist# = od#
          nearOppY# = pY@[oi#]
        END IF
      END FOR
      IF nearOppDist# < 80 THEN
        IF targetY# > nearOppY# THEN
          targetY# = targetY# + 30
        ELSE
          targetY# = targetY# - 30
        END IF
      END IF
      pushStr# = 0.25

    ELSE
      ' Opponent has puck — defensive positioning
      defX# = puckX# - 80
      IF defX# < GOAL_LEFT_X# + 60 THEN
        defX# = GOAL_LEFT_X# + 60
      END IF

      IF i# = 1 THEN
        targetX# = defX#
        targetY# = puckY# - 60
      ELSE IF i# = 2 THEN
        targetX# = defX#
        targetY# = puckY# + 60
      ELSE
        targetX# = defX# + 40
        targetY# = puckY#
      END IF
    END IF

    ' Clamp targets to ice
    targetX# = MAX# A targetX#, B (ICE_LEFT# + 30)
    targetY# = MAX# A targetY#, B (ICE_TOP# + 20)
    targetX# = MIN# A targetX#, B (ICE_RIGHT# - 50)
    targetY# = MIN# A targetY#, B (ICE_BOTTOM# - 50)

    ' Move toward target
    dx# = targetX# - pX@[i#]
    dy# = targetY# - pY@[i#]
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)

    IF dist# > 10 THEN
      pPushing@[i#] = 1
      pVX@[i#] = pVX@[i#] + (dx# / dist#) * spd# * pushStr#
      pVY@[i#] = pVY@[i#] + (dy# / dist#) * spd# * pushStr#
    ELSE
      pPushing@[i#] = 0
    END IF

    ' Update facing
    IF dx# > 5 THEN
      pDir@[i#] = 1
    ELSE IF dx# < -5 THEN
      pDir@[i#] = -1
    END IF
  END FOR
END FUNCTION

FUNCTION updateOpponentAI
  FOR i# FROM 5 TO 7
    IF pState@[i#] = 2 THEN
      CONTINUE
    END IF

    rIdx# = pRoster@[i#]
    spd# = oSpeed@[rIdx#] * 0.3 + 1.5
    pushStr# = 0.2

    IF puckOwner# = i# THEN
      ' === This opponent has the puck ===
      distToGoal# = pX@[i#] - GOAL_LEFT_X#

      ' Check if a Whaler is close (pressure)
      underPressure? = NO
      FOR wi# FROM 1 TO 3
        wpx# = pX@[wi#] - pX@[i#]
        wpy# = pY@[wi#] - pY@[i#]
        wpd# = SQRT# VALUE (wpx# * wpx# + wpy# * wpy#)
        IF wpd# < 60 THEN
          underPressure? = YES
        END IF
      END FOR

      ' Consider passing to an open teammate
      IF underPressure? AND RANDOM# MAX 100 < 4 THEN
        ' Find most open teammate
        bestPassIdx# = 0
        bestPassScore# = -99999
        FOR ti# FROM 5 TO 7
          IF ti# = i# OR pState@[ti#] = 2 THEN
            CONTINUE
          END IF
          tdx# = pX@[ti#] - pX@[i#]
          tdy# = pY@[ti#] - pY@[i#]
          tDist# = SQRT# VALUE (tdx# * tdx# + tdy# * tdy#)
          IF tDist# < 40 THEN
            CONTINUE
          END IF
          ' How far from nearest Whaler?
          minWD# = 99999
          FOR wi# FROM 1 TO 3
            wx# = pX@[wi#] - pX@[ti#]
            wy# = pY@[wi#] - pY@[ti#]
            wd# = SQRT# VALUE (wx# * wx# + wy# * wy#)
            IF wd# < minWD# THEN
              minWD# = wd#
            END IF
          END FOR
          sc# = minWD# - tDist# * 0.3
          IF sc# > bestPassScore# THEN
            bestPassScore# = sc#
            bestPassIdx# = ti#
          END IF
        END FOR

        IF bestPassIdx# > 0 THEN
          ' Pass to teammate
          pdx# = pX@[bestPassIdx#] - puckX#
          pdy# = pY@[bestPassIdx#] - puckY#
          pDist# = SQRT# VALUE (pdx# * pdx# + pdy# * pdy#)
          IF pDist# > 0 THEN
            puckVX# = (pdx# / pDist#) * PASS_SPEED#
            puckVY# = (pdy# / pDist#) * PASS_SPEED#
          END IF
          pHasPuck@[i#] = 0
          puckOwner# = 0
          puckLoose? = YES
          puckFreezeUntil# = now# + 150
          CONTINUE
        END IF
      END IF

      ' Shoot if close enough and have a decent angle
      IF distToGoal# < 250 THEN
        ' Don't shoot every frame — random chance increases as closer
        shootChance# = 3
        IF distToGoal# < 150 THEN
          shootChance# = 6
        END IF
        IF distToGoal# < 100 THEN
          shootChance# = 12
        END IF
        IF RANDOM# MAX 100 < shootChance# THEN
          sdx# = GOAL_LEFT_X# - puckX#
          ' Aim slightly off-center for variety
          goalAimY# = 240 + RANDOM# MAX 40 - 20
          sdy# = goalAimY# - puckY#
          sDist# = SQRT# VALUE (sdx# * sdx# + sdy# * sdy#)
          oPower# = SHOT_POWER_MIN# + (SHOT_POWER_MAX# - SHOT_POWER_MIN#) * 0.7
          oPower# = oPower# * (0.7 + oShot@[rIdx#] * 0.03)
          IF sDist# > 0 THEN
            puckVX# = (sdx# / sDist#) * oPower#
            puckVY# = (sdy# / sDist#) * oPower#
          ELSE
            puckVX# = 0 - oPower#
            puckVY# = 0
          END IF
          pHasPuck@[i#] = 0
          puckOwner# = 0
          puckLoose? = YES
          puckFreezeUntil# = now# + 200
          pAnim@[i#] = ANIM_SHOOT#
          pAnimFrame@[i#] = 1
          pAnimTimer@[i#] = 0
          CONTINUE
        END IF
      END IF

      ' Skate toward goal, weaving slightly to avoid defenders
      targetX# = GOAL_LEFT_X# + 80
      targetY# = 240 + SIN# VALUE (now# * 0.003) * 60
      pushStr# = 0.3

    ELSE IF puckOwner# >= 5 AND puckOwner# <= 7 THEN
      ' === Teammate has puck — get open for a pass ===
      carrierX# = pX@[puckOwner#]

      ' Skate ahead of carrier in lanes, weave to stay open
      IF i# = 5 THEN
        laneY# = 160
      ELSE IF i# = 6 THEN
        laneY# = 320
      ELSE
        laneY# = 240
      END IF

      targetX# = carrierX# - 100 - RANDOM# MAX 30
      targetY# = laneY# + SIN# VALUE (now# * 0.002 + i# * 2) * 40

      ' Avoid nearest Whaler
      nearWDist# = 99999
      nearWY# = targetY#
      FOR wi# FROM 1 TO 3
        wx# = pX@[wi#] - targetX#
        wy# = pY@[wi#] - targetY#
        wd# = SQRT# VALUE (wx# * wx# + wy# * wy#)
        IF wd# < nearWDist# THEN
          nearWDist# = wd#
          nearWY# = pY@[wi#]
        END IF
      END FOR
      IF nearWDist# < 70 THEN
        IF targetY# > nearWY# THEN
          targetY# = targetY# + 25
        ELSE
          targetY# = targetY# - 25
        END IF
      END IF
      pushStr# = 0.25

    ELSE
      ' === Puck is loose or Whalers have it ===
      ' Closest opponent chases, others play defense
      closestOpp# = 5
      closestDist# = 99999
      FOR ci# FROM 5 TO 7
        IF pState@[ci#] = 2 THEN
          CONTINUE
        END IF
        cdx# = pX@[ci#] - puckX#
        cdy# = pY@[ci#] - puckY#
        cd# = SQRT# VALUE (cdx# * cdx# + cdy# * cdy#)
        IF cd# < closestDist# THEN
          closestDist# = cd#
          closestOpp# = ci#
        END IF
      END FOR

      IF i# = closestOpp# THEN
        ' Chase the puck or carrier
        IF puckLoose? THEN
          targetX# = puckX#
          targetY# = puckY#
        ELSE
          targetX# = pX@[puckOwner#]
          targetY# = pY@[puckOwner#]
        END IF
        pushStr# = 0.3
      ELSE
        ' Defend: position between puck and our goal, spread across lanes
        defX# = puckX# + 80
        IF defX# > GOAL_RIGHT_X# - 60 THEN
          defX# = GOAL_RIGHT_X# - 60
        END IF

        IF i# = 5 THEN
          targetX# = defX#
          targetY# = puckY# - 60
        ELSE IF i# = 6 THEN
          targetX# = defX#
          targetY# = puckY# + 60
        ELSE
          targetX# = defX# - 40
          targetY# = puckY#
        END IF
        pushStr# = 0.2
      END IF
    END IF

    ' Clamp targets to ice
    targetX# = MAX# A targetX#, B (ICE_LEFT# + 30)
    targetY# = MAX# A targetY#, B (ICE_TOP# + 20)
    targetX# = MIN# A targetX#, B (ICE_RIGHT# - 50)
    targetY# = MIN# A targetY#, B (ICE_BOTTOM# - 50)

    ' Move toward target
    dx# = targetX# - pX@[i#]
    dy# = targetY# - pY@[i#]
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)

    IF dist# > 10 THEN
      pPushing@[i#] = 1
      pVX@[i#] = pVX@[i#] + (dx# / dist#) * spd# * pushStr#
      pVY@[i#] = pVY@[i#] + (dy# / dist#) * spd# * pushStr#
    ELSE
      pPushing@[i#] = 0
    END IF

    ' Update facing
    IF dx# > 5 THEN
      pDir@[i#] = 1
    ELSE IF dx# < -5 THEN
      pDir@[i#] = -1
    END IF
  END FOR
END FUNCTION

FUNCTION updateGoalieAI
  FOR gi# FROM 1 TO 2
    IF gi# = 1 THEN
      g# = 4
      goalX# = GOAL_LEFT_X#
      homeX# = GOAL_LEFT_X# + 15
      tStart# = 1
      tEnd# = 3
      oStart# = 5
      oEnd# = 7
      clearDirX# = 1
      minGX# = GOAL_LEFT_X# - 5
      maxGX# = GOAL_LEFT_X# + 40
    ELSE
      g# = 8
      goalX# = GOAL_RIGHT_X#
      homeX# = GOAL_RIGHT_X# - 15
      tStart# = 5
      tEnd# = 7
      oStart# = 1
      oEnd# = 3
      clearDirX# = -1
      minGX# = GOAL_RIGHT_X# - 40
      maxGX# = GOAL_RIGHT_X# + 5
    END IF

    IF pState@[g#] = 2 THEN
      CONTINUE
    END IF

    minGY# = 240 - GOAL_H# / 2 - 15
    maxGY# = 240 + GOAL_H# / 2 + 15

    IF puckOwner# = g# THEN
      ' === Goalie has the puck (made a save) ===
      holdTime# = now# - goalieHoldTime#

      ' Count nearby opponents
      nearOpps# = 0
      FOR oi# FROM oStart# TO oEnd#
        ox# = pX@[oi#] - pX@[g#]
        oy# = pY@[oi#] - pY@[g#]
        od# = SQRT# VALUE (ox# * ox# + oy# * oy#)
        IF od# < 150 THEN
          nearOpps# = nearOpps# + 1
        END IF
      END FOR

      IF holdTime# < 600 THEN
        ' Brief hold — drift toward center of crease
        dy# = 240 - pY@[g#]
        IF dy# > 5 THEN
          pVY@[g#] = pVY@[g#] + 0.3
        ELSE IF dy# < -5 THEN
          pVY@[g#] = pVY@[g#] - 0.3
        END IF

      ELSE IF nearOpps# >= 2 AND holdTime# < 1500 THEN
        ' Too many opponents nearby — move to get separation
        closeDist# = 99999
        closeY# = pY@[g#]
        FOR oi# FROM oStart# TO oEnd#
          ox# = pX@[oi#] - pX@[g#]
          oy# = pY@[oi#] - pY@[g#]
          od# = SQRT# VALUE (ox# * ox# + oy# * oy#)
          IF od# < closeDist# THEN
            closeDist# = od#
            closeY# = pY@[oi#]
          END IF
        END FOR
        ' Move away from closest opponent
        IF closeY# > pY@[g#] THEN
          pVY@[g#] = pVY@[g#] - 1.0
        ELSE
          pVY@[g#] = pVY@[g#] + 1.0
        END IF

      ELSE
        ' Time to pass — find most open teammate
        bestIdx# = 0
        bestScore# = -99999
        FOR ti# FROM tStart# TO tEnd#
          IF pState@[ti#] = 2 THEN
            CONTINUE
          END IF
          tdx# = pX@[ti#] - pX@[g#]
          tdy# = pY@[ti#] - pY@[g#]
          tDist# = SQRT# VALUE (tdx# * tdx# + tdy# * tdy#)
          IF tDist# < 30 THEN
            CONTINUE
          END IF
          ' How far is this teammate from nearest opponent?
          minOD# = 99999
          FOR oi# FROM oStart# TO oEnd#
            ox# = pX@[oi#] - pX@[ti#]
            oy# = pY@[oi#] - pY@[ti#]
            od# = SQRT# VALUE (ox# * ox# + oy# * oy#)
            IF od# < minOD# THEN
              minOD# = od#
            END IF
          END FOR
          ' Prefer open teammates, slight preference for closer ones
          sc# = minOD# - tDist# * 0.3
          IF sc# > bestScore# THEN
            bestScore# = sc#
            bestIdx# = ti#
          END IF
        END FOR

        IF bestIdx# > 0 THEN
          ' Pass to best teammate
          pdx# = pX@[bestIdx#] - puckX#
          pdy# = pY@[bestIdx#] - puckY#
          pDist# = SQRT# VALUE (pdx# * pdx# + pdy# * pdy#)
          IF pDist# > 0 THEN
            puckVX# = (pdx# / pDist#) * PASS_SPEED#
            puckVY# = (pdy# / pDist#) * PASS_SPEED#
          END IF
          pHasPuck@[g#] = 0
          puckOwner# = 0
          puckLoose? = YES
          puckFreezeUntil# = now# + 150
        ELSE
          ' No good target — clear it forward
          puckVX# = clearDirX# * PASS_SPEED# * 0.8
          puckVY# = 0
          pHasPuck@[g#] = 0
          puckOwner# = 0
          puckLoose? = YES
          puckFreezeUntil# = now# + 150
        END IF
      END IF

    ELSE
      ' === Goalie doesn't have puck — track it ===
      targetY# = puckY#
      targetY# = MAX# A targetY#, B minGY#
      targetY# = MIN# A targetY#, B maxGY#

      dy# = targetY# - pY@[g#]
      IF dy# > 3 THEN
        pVY@[g#] = pVY@[g#] + 1.5
      ELSE IF dy# < -3 THEN
        pVY@[g#] = pVY@[g#] - 1.5
      END IF

      ' Stay near goal line
      dx# = homeX# - pX@[g#]
      IF dx# > 3 THEN
        pVX@[g#] = pVX@[g#] + 0.5
      ELSE IF dx# < -3 THEN
        pVX@[g#] = pVX@[g#] - 0.5
      END IF
    END IF

    ' Clamp goalie to crease area
    pX@[g#] = MAX# A pX@[g#], B minGX#
    pX@[g#] = MIN# A pX@[g#], B maxGX#
    pY@[g#] = MAX# A pY@[g#], B minGY#
    pY@[g#] = MIN# A pY@[g#], B maxGY#

    ' Face the puck
    IF puckX# > pX@[g#] THEN
      pDir@[g#] = 1
    ELSE
      pDir@[g#] = -1
    END IF
  END FOR
END FUNCTION

FUNCTION updatePuck
  IF puckOwner# > 0 THEN
    ' Puck attached to carrier (on stick blade)
    offX# = 14
    IF pDir@[puckOwner#] = -1 THEN
      offX# = -2
    END IF
    puckX# = pX@[puckOwner#] + offX# * PLAYER_SCALE#
    puckY# = pY@[puckOwner#] + 13 * PLAYER_SCALE#
    puckVX# = 0
    puckVY# = 0
    RETURN
  END IF

  ' Apply friction
  puckVX# = puckVX# * PUCK_FRICTION#
  puckVY# = puckVY# * PUCK_FRICTION#

  ' Clamp tiny velocities
  IF ABS# VALUE puckVX# < 0.05 THEN
    puckVX# = 0
  END IF
  IF ABS# VALUE puckVY# < 0.05 THEN
    puckVY# = 0
  END IF

  ' Update position
  puckX# = puckX# + puckVX#
  puckY# = puckY# + puckVY#

  ' Board collision (top/bottom bounce)
  IF puckY# < ICE_TOP# THEN
    puckY# = ICE_TOP#
    puckVY# = ABS# VALUE puckVY# * 0.7
  END IF
  IF puckY# > ICE_BOTTOM# - 8 THEN
    puckY# = ICE_BOTTOM# - 8
    puckVY# = 0 - ABS# VALUE puckVY# * 0.7
  END IF

  ' Left/right boards (but not in goal mouth)
  IF puckX# < ICE_LEFT# THEN
    IF puckY# > 240 - GOAL_H# / 2 AND puckY# < 240 + GOAL_H# / 2 THEN
      ' Into left goal area — let checkGoals handle it
    ELSE
      puckX# = ICE_LEFT#
      puckVX# = ABS# VALUE puckVX# * 0.7
    END IF
  END IF
  IF puckX# > ICE_RIGHT# - 8 THEN
    IF puckY# > 240 - GOAL_H# / 2 AND puckY# < 240 + GOAL_H# / 2 THEN
      ' Into right goal area — let checkGoals handle it
    ELSE
      puckX# = ICE_RIGHT# - 8
      puckVX# = 0 - ABS# VALUE puckVX# * 0.7
    END IF
  END IF

  ' Pickup detection (if not frozen)
  IF now# > puckFreezeUntil# THEN
    FOR i# FROM 1 TO NUM_PLAYERS#
      IF pState@[i#] = 2 THEN
        CONTINUE
      END IF
      dx# = pX@[i#] + 8 * PLAYER_SCALE# - puckX#
      dy# = pY@[i#] + 10 * PLAYER_SCALE# - puckY#
      dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)
      IF dist# < 20 THEN
        ' One-timer check: Whaler picking up a pass while Z held
        IF passInFlight? AND now# - passTime# < 500 THEN
          IF i# >= 1 AND i# <= 3 AND i# <> activeP# AND inputShoot? THEN
            ' ONE-TIMER! Auto-shoot with bonus power
            otPower# = SHOT_POWER_MAX# * 1.3
            gdx# = GOAL_RIGHT_X# - puckX#
            gdy# = 240 - puckY#
            gDist# = SQRT# VALUE (gdx# * gdx# + gdy# * gdy#)
            IF gDist# > 0 THEN
              puckVX# = (gdx# / gDist#) * otPower#
              puckVY# = (gdy# / gDist#) * otPower#
            ELSE
              puckVX# = otPower#
              puckVY# = 0
            END IF
            puckOwner# = 0
            puckLoose? = YES
            puckFreezeUntil# = now# + 200
            passInFlight? = NO
            activeP# = i#
            RETURN
          END IF
        END IF

        puckOwner# = i#
        puckLoose? = NO
        pHasPuck@[i#] = 1
        passInFlight? = NO
        ' Auto-switch to Whaler who picks up puck
        IF i# >= 1 AND i# <= 3 THEN
          activeP# = i#
        END IF
        ' Track when goalie gets the puck
        IF i# = 4 OR i# = 8 THEN
          goalieHoldTime# = now#
        END IF
        BREAK
      END IF
    END FOR
  END IF
END FUNCTION

FUNCTION handleShooting
  ap# = activeP#

  ' Only the active player shoots via human input
  IF puckOwner# <> ap# THEN
    shotCharging? = NO
    RETURN
  END IF

  IF inputShoot? THEN
    IF NOT shotCharging? THEN
      ' Start charging
      shotCharging? = YES
      shotChargeStart# = now#
    END IF
  ELSE
    IF shotCharging? THEN
      ' Release shot!
      chargeMs# = now# - shotChargeStart#
      chargePct# = MIN# A (chargeMs# / SHOT_CHARGE_TIME#), B 1.0

      rIdx# = pRoster@[ap#]
      shotStat# = wShot@[rIdx#]
      power# = SHOT_POWER_MIN# + chargePct# * (SHOT_POWER_MAX# - SHOT_POWER_MIN#)
      power# = power# * (0.7 + shotStat# * 0.03)

      ' Shot direction: toward opponent goal
      goalY# = 240
      dx# = GOAL_RIGHT_X# - puckX#
      dy# = goalY# - puckY#
      dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)

      IF dist# > 0 THEN
        puckVX# = (dx# / dist#) * power#
        puckVY# = (dy# / dist#) * power#
      ELSE
        puckVX# = power#
        puckVY# = 0
      END IF

      ' Release puck
      pHasPuck@[ap#] = 0
      puckOwner# = 0
      puckLoose? = YES
      puckFreezeUntil# = now# + 200

      ' Trigger shoot animation
      pAnim@[ap#] = ANIM_SHOOT#
      pAnimFrame@[ap#] = 1
      pAnimTimer@[ap#] = 0

      shotCharging? = NO
    END IF
  END IF
END FUNCTION

FUNCTION handlePassing
  ap# = activeP#

  IF NOT passPressed? THEN
    RETURN
  END IF
  IF puckOwner# <> ap# THEN
    ' No puck — switch player instead
    switchActivePlayer
    RETURN
  END IF

  ' Determine input direction (default to facing)
  dirX# = inputX#
  dirY# = inputY#
  IF dirX# = 0 AND dirY# = 0 THEN
    dirX# = pDir@[ap#]
  END IF

  ' Find teammate most aligned with input direction
  ' Use dot product between input direction and direction-to-teammate
  bestDot# = -99999
  bestTarget# = 0
  FOR ti# FROM 1 TO 3
    IF ti# = ap# THEN
      CONTINUE
    END IF
    IF pState@[ti#] = 2 THEN
      CONTINUE
    END IF
    ' Direction from passer to teammate
    tdx# = pX@[ti#] - pX@[ap#]
    tdy# = pY@[ti#] - pY@[ap#]
    tDist# = SQRT# VALUE (tdx# * tdx# + tdy# * tdy#)
    IF tDist# < 10 THEN
      CONTINUE
    END IF
    tdx# = tdx# / tDist#
    tdy# = tdy# / tDist#
    ' Dot product with input direction
    dot# = tdx# * dirX# + tdy# * dirY#
    IF dot# > bestDot# THEN
      bestDot# = dot#
      bestTarget# = ti#
    END IF
  END FOR

  ' Aim pass at where the target teammate will be
  IF bestTarget# > 0 THEN
    ' Estimate travel time: distance / pass speed
    rawDX# = pX@[bestTarget#] - puckX#
    rawDY# = pY@[bestTarget#] - puckY#
    rawDist# = SQRT# VALUE (rawDX# * rawDX# + rawDY# * rawDY#)
    IF rawDist# > 0 THEN
      travelFrames# = rawDist# / PASS_SPEED#
    ELSE
      travelFrames# = 0
    END IF
    ' Lead the target based on their velocity
    leadX# = pX@[bestTarget#] + pVX@[bestTarget#] * travelFrames# * 0.6
    leadY# = pY@[bestTarget#] + pVY@[bestTarget#] * travelFrames# * 0.6
    passDX# = leadX# - puckX#
    passDY# = leadY# - puckY#
    pDist# = SQRT# VALUE (passDX# * passDX# + passDY# * passDY#)
    IF pDist# > 0 THEN
      passDX# = passDX# / pDist#
      passDY# = passDY# / pDist#
    END IF
  ELSE
    ' No valid target — pass in raw input direction
    pDist# = SQRT# VALUE (dirX# * dirX# + dirY# * dirY#)
    IF pDist# > 0 THEN
      passDX# = dirX# / pDist#
      passDY# = dirY# / pDist#
    ELSE
      passDX# = pDir@[ap#]
      passDY# = 0
    END IF
  END IF

  ' Release puck
  puckVX# = passDX# * PASS_SPEED#
  puckVY# = passDY# * PASS_SPEED#
  pHasPuck@[ap#] = 0
  puckOwner# = 0
  puckLoose? = YES
  puckFreezeUntil# = now# + 150

  passInFlight? = YES
  passTime# = now#
END FUNCTION

FUNCTION handleChecking
  ap# = activeP#

  ' Z = check only when active player doesn't have the puck
  IF puckOwner# = ap# THEN
    RETURN
  END IF
  IF NOT inputShoot? THEN
    RETURN
  END IF
  IF now# < checkCooldown# THEN
    RETURN
  END IF

  ' Lunge in facing direction
  lungeDir# = pDir@[ap#]
  pVX@[ap#] = pVX@[ap#] + lungeDir# * CHECK_POWER# * 1.5
  checkCooldown# = now# + CHECK_COOLDOWN_MS#

  ' Check for collision with opponents
  rIdx# = pRoster@[ap#]
  checkStat# = wCheck@[rIdx#]

  FOR i# FROM 5 TO 7
    IF pState@[i#] = 2 THEN
      CONTINUE
    END IF
    dx# = pX@[i#] - pX@[ap#]
    dy# = pY@[i#] - pY@[ap#]
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)

    IF dist# < CHECK_RADIUS# * PLAYER_SCALE# THEN
      ' HIT!
      hitPower# = checkStat# * 0.5 + 3

      ' Knock opponent back
      IF dist# > 0 THEN
        knockX# = dx# / dist# * hitPower#
        knockY# = dy# / dist# * hitPower#
      ELSE
        knockX# = lungeDir# * hitPower#
        knockY# = 0
      END IF

      pVX@[i#] = pVX@[i#] + knockX#
      pVY@[i#] = pVY@[i#] + knockY#
      pState@[i#] = 2
      pStateT@[i#] = now#
      pAnim@[i#] = ANIM_KNOCKED#
      pAnimFrame@[i#] = 1
      pAnimTimer@[i#] = 0

      ' If checked player had puck, drop it
      IF puckOwner# = i# THEN
        pHasPuck@[i#] = 0
        puckOwner# = 0
        puckLoose? = YES
        puckVX# = knockX# * 0.5
        puckVY# = knockY# * 0.5
      END IF

      ' Chance to trigger fight
      IF RANDOM# MAX 100 < FIGHT_CHANCE# THEN
        fightP1# = ap#
        fightP2# = i#
        startFight
      END IF

      BREAK
    END IF
  END FOR
END FUNCTION

FUNCTION handleOpponentChecking
  ' Opponents check the puck carrier if close enough
  IF puckOwner# < 1 OR puckOwner# > 3 THEN
    RETURN
  END IF

  FOR i# FROM 5 TO 7
    IF pState@[i#] = 2 THEN
      CONTINUE
    END IF

    dx# = pX@[puckOwner#] - pX@[i#]
    dy# = pY@[puckOwner#] - pY@[i#]
    dist# = SQRT# VALUE (dx# * dx# + dy# * dy#)

    IF dist# < CHECK_RADIUS# * PLAYER_SCALE# THEN
      ' Random chance to check (roughly 1 in 30 frames when in range)
      IF RANDOM# MAX 100 < 3 THEN
        rIdx# = pRoster@[i#]
        hitPower# = oCheck@[rIdx#] * 0.5 + 3

        IF dist# > 0 THEN
          knockX# = dx# / dist# * hitPower#
          knockY# = dy# / dist# * hitPower#
        ELSE
          knockX# = pDir@[i#] * hitPower#
          knockY# = 0
        END IF

        carrier# = puckOwner#
        pVX@[carrier#] = pVX@[carrier#] + knockX#
        pVY@[carrier#] = pVY@[carrier#] + knockY#
        pState@[carrier#] = 2
        pStateT@[carrier#] = now#
        pAnim@[carrier#] = ANIM_KNOCKED#
        pAnimFrame@[carrier#] = 1
        pAnimTimer@[carrier#] = 0

        ' Drop puck
        pHasPuck@[carrier#] = 0
        puckOwner# = 0
        puckLoose? = YES
        puckVX# = knockX# * 0.5
        puckVY# = knockY# * 0.5

        ' Chance to trigger fight
        IF RANDOM# MAX 100 < FIGHT_CHANCE# THEN
          fightP1# = carrier#
          fightP2# = i#
          startFight
        END IF

        BREAK
      END IF
    END IF
  END FOR
END FUNCTION

FUNCTION checkGoals
  ' Whalers defend LEFT goal, opponent defends RIGHT

  ' Check right goal (opponent's goal — Whalers score)
  IF puckX# > GOAL_RIGHT_X# + GOAL_W# THEN
    IF puckY# > 240 - GOAL_H# / 2 AND puckY# < 240 + GOAL_H# / 2 THEN
      scoreW# = scoreW# + 1
      ' Reset puck to center
      puckOwner# = 0
      puckLoose? = YES
      puckX# = 600
      puckY# = 240
      puckVX# = 0
      puckVY# = 0
      shotCharging? = NO
      passInFlight? = NO
    END IF
  END IF

  ' Check left goal (Whalers' goal — opponent scores)
  IF puckX# < GOAL_LEFT_X# - GOAL_W# THEN
    IF puckY# > 240 - GOAL_H# / 2 AND puckY# < 240 + GOAL_H# / 2 THEN
      scoreO# = scoreO# + 1
      ' Reset puck to center
      puckOwner# = 0
      puckLoose? = YES
      puckX# = 600
      puckY# = 240
      puckVX# = 0
      puckVY# = 0
      shotCharging? = NO
      passInFlight? = NO
    END IF
  END IF
END FUNCTION

' ============ FIGHTING ============

FUNCTION startFight
  fightHP1# = 100
  fightHP2# = 100
  fightCooldown1# = now# + 500
  fightCooldown2# = now# + 1200
  fightWinner# = 0
  fightStart# = now#
  fightHitTimer1# = 0
  fightHitTimer2# = 0
  fightPunchTimer1# = 0
  fightPunchTimer2# = 0
  fightEndTimer# = 0

  ' Store fight center for bobbing movement
  fightCenterX# = (pX@[fightP1#] + pX@[fightP2#]) / 2
  fightCenterY# = (pY@[fightP1#] + pY@[fightP2#]) / 2

  ' Position fighters facing each other (bodies separate, punches connect)
  pX@[fightP1#] = fightCenterX# - 14
  pX@[fightP2#] = fightCenterX# + 14
  pY@[fightP1#] = fightCenterY#
  pY@[fightP2#] = fightCenterY#
  pDir@[fightP1#] = 1
  pDir@[fightP2#] = -1

  ' Stop all players
  FOR i# FROM 1 TO NUM_PLAYERS#
    pVX@[i#] = 0
    pVY@[i#] = 0
  END FOR

  ' Drop puck at fight location
  IF puckOwner# > 0 THEN
    pHasPuck@[puckOwner#] = 0
    puckOwner# = 0
    puckLoose? = YES
  END IF
  puckX# = fightCenterX#
  puckY# = fightCenterY# + 30
  puckVX# = 0
  puckVY# = 0

  ' Clear stun on fighters and set idle pose
  pState@[fightP1#] = 0
  pState@[fightP2#] = 0
  pAnim@[fightP1#] = ANIM_SKATE#
  pAnimFrame@[fightP1#] = 2
  pAnim@[fightP2#] = ANIM_SKATE#
  pAnimFrame@[fightP2#] = 2

  ' Camera follows Whaler fighter
  activeP# = fightP1#

  gameState# = STATE_FIGHT#
END FUNCTION

FUNCTION updateFight
  elapsed# = now# - fightStart#

  ' KO decided — hold the knockdown pose, then end
  IF fightWinner# > 0 THEN
    IF now# - fightEndTimer# > 800 THEN
      endFight
    END IF
    RETURN
  END IF

  ' === Fighter movement: bob back and forth ===
  bobPhase1# = SIN# VALUE (elapsed# * 0.004) * 3
  bobPhase2# = SIN# VALUE (elapsed# * 0.0035 + 1.5) * 3

  ' Recoil when hit (push away from opponent)
  recoil1# = 0
  recoil2# = 0
  IF fightHitTimer1# > 0 THEN
    hitAge1# = now# - fightHitTimer1#
    IF hitAge1# < 300 THEN
      recoil1# = (300 - hitAge1#) / 300 * -5
    END IF
  END IF
  IF fightHitTimer2# > 0 THEN
    hitAge2# = now# - fightHitTimer2#
    IF hitAge2# < 300 THEN
      recoil2# = (300 - hitAge2#) / 300 * 5
    END IF
  END IF

  ' Lunge forward when punching (arm reaches opponent's body)
  lunge1# = 0
  lunge2# = 0
  IF fightPunchTimer1# > 0 AND now# - fightPunchTimer1# < 200 THEN
    lunge1# = 8
  END IF
  IF fightPunchTimer2# > 0 AND now# - fightPunchTimer2# < 200 THEN
    lunge2# = -8
  END IF

  pX@[fightP1#] = fightCenterX# - 14 + bobPhase1# + recoil1# + lunge1#
  pX@[fightP2#] = fightCenterX# + 14 + bobPhase2# + recoil2# + lunge2#

  ' Always face opponent
  IF pX@[fightP2#] > pX@[fightP1#] THEN
    pDir@[fightP1#] = 1
    pDir@[fightP2#] = -1
  ELSE
    pDir@[fightP1#] = -1
    pDir@[fightP2#] = 1
  END IF

  ' === Player punches (Z button, with cooldown) ===
  IF inputShoot? AND now# > fightCooldown1# THEN
    rIdx# = pRoster@[fightP1#]
    punchPower# = wFight@[rIdx#] * 2 + 5
    fightHP2# = fightHP2# - punchPower#
    fightCooldown1# = now# + FIGHT_PUNCH_COOLDOWN#
    fightPunchTimer1# = now#
    fightHitTimer2# = now#

    PLAY "T200 L32 O3 C", BACKGROUND YES
  END IF

  ' === AI punches (slower baseline, faster with better stat) ===
  oRIdx# = pRoster@[fightP2#]
  aiPunchInterval# = 1800 - oFight@[oRIdx#] * 80
  IF aiPunchInterval# < 700 THEN
    aiPunchInterval# = 700
  END IF

  IF now# > fightCooldown2# THEN
    punchPower# = oFight@[oRIdx#] * 2 + 5
    fightHP1# = fightHP1# - punchPower#
    fightCooldown2# = now# + aiPunchInterval#
    fightPunchTimer2# = now#
    fightHitTimer1# = now#

    PLAY "T200 L32 O3 D", BACKGROUND YES
  END IF

  ' === Fighter animations (priority: stagger > punch > idle) ===
  ' Stagger = skate frame 3 (not full knockdown), punch = shoot frame 2
  IF fightHitTimer1# > 0 AND now# - fightHitTimer1# < 300 THEN
    pAnim@[fightP1#] = ANIM_SKATE#
    pAnimFrame@[fightP1#] = 3
  ELSE IF fightPunchTimer1# > 0 AND now# - fightPunchTimer1# < 200 THEN
    pAnim@[fightP1#] = ANIM_SHOOT#
    pAnimFrame@[fightP1#] = 2
  ELSE
    pAnim@[fightP1#] = ANIM_SKATE#
    pAnimFrame@[fightP1#] = 2
  END IF

  IF fightHitTimer2# > 0 AND now# - fightHitTimer2# < 300 THEN
    pAnim@[fightP2#] = ANIM_SKATE#
    pAnimFrame@[fightP2#] = 3
  ELSE IF fightPunchTimer2# > 0 AND now# - fightPunchTimer2# < 200 THEN
    pAnim@[fightP2#] = ANIM_SHOOT#
    pAnimFrame@[fightP2#] = 2
  ELSE
    pAnim@[fightP2#] = ANIM_SKATE#
    pAnimFrame@[fightP2#] = 2
  END IF

  ' Clamp HP
  IF fightHP1# < 0 THEN
    fightHP1# = 0
  END IF
  IF fightHP2# < 0 THEN
    fightHP2# = 0
  END IF

  ' Check for KO or timeout
  IF fightHP1# <= 0 THEN
    fightWinner# = 2
  ELSE IF fightHP2# <= 0 THEN
    fightWinner# = 1
  ELSE IF elapsed# > FIGHT_DURATION# THEN
    IF fightHP1# >= fightHP2# THEN
      fightWinner# = 1
    ELSE
      fightWinner# = 2
    END IF
  END IF

  ' When winner decided, set KO pose on loser + sad trombone
  IF fightWinner# > 0 THEN
    fightEndTimer# = now#
    PLAY "T180 L8 O3 B L8 B- L8 A L4 A-", BACKGROUND YES
    IF fightWinner# = 1 THEN
      pAnim@[fightP2#] = ANIM_KNOCKED#
      pAnimFrame@[fightP2#] = 1
      pAnim@[fightP1#] = ANIM_SKATE#
      pAnimFrame@[fightP1#] = 2
    ELSE
      pAnim@[fightP1#] = ANIM_KNOCKED#
      pAnimFrame@[fightP1#] = 1
      pAnim@[fightP2#] = ANIM_SKATE#
      pAnimFrame@[fightP2#] = 2
    END IF
  END IF
END FUNCTION

FUNCTION endFight
  ' Reset fighter states
  pState@[fightP1#] = 0
  pState@[fightP2#] = 0
  pAnim@[fightP1#] = ANIM_SKATE#
  pAnimFrame@[fightP1#] = 2
  pAnim@[fightP2#] = ANIM_SKATE#
  pAnimFrame@[fightP2#] = 2

  ' Reset puck to center
  puckX# = CENTER_X#
  puckY# = 240
  puckVX# = 0
  puckVY# = 0
  puckOwner# = 0
  puckLoose? = YES
  shotCharging? = NO
  passInFlight? = NO

  gameState# = STATE_PLAY#
END FUNCTION

FUNCTION drawFight
  ' Header text
  IF fightWinner# = 1 THEN
    SETCOLOR GREEN&
    PRINTAT 3, 34, "YOU WIN!"
  ELSE IF fightWinner# = 2 THEN
    SETCOLOR RED&
    PRINTAT 3, 33, "YOU LOSE!"
  ELSE
    SETCOLOR RED&
    PRINTAT 3, 35, "FIGHT!"
  END IF

  ' Health bars — fixed screen positions, spread apart
  barW# = 120
  barH# = 10
  barY# = 10

  ' Whaler health bar (left side of screen)
  SETCOLOR DARKGRAY&
  DRAWBOX X1 40, Y1 barY#, X2 (40 + barW#), Y2 (barY# + barH#), FILL YES
  SETCOLOR GREEN&
  fillW# = barW# * fightHP1# / 100
  IF fillW# > 0 THEN
    DRAWBOX X1 40, Y1 barY#, X2 (40 + fillW#), Y2 (barY# + barH#), FILL YES
  END IF
  SETCOLOR WHITE&
  PRINTAT 1, 2, "WHR"

  ' Opponent health bar (right side of screen)
  SETCOLOR DARKGRAY&
  DRAWBOX X1 (640 - 40 - barW#), Y1 barY#, X2 (640 - 40), Y2 (barY# + barH#), FILL YES
  SETCOLOR RED&
  fillW# = barW# * fightHP2# / 100
  IF fillW# > 0 THEN
    DRAWBOX X1 (640 - 40 - barW#), Y1 barY#, X2 (640 - 40 - barW# + fillW#), Y2 (barY# + barH#), FILL YES
  END IF
  SETCOLOR WHITE&
  PRINTAT 1, 76, "OPP"

  ' Controls hint
  IF fightWinner# = 0 THEN
    PRINTAT 4, 33, "Z = PUNCH"
  END IF
END FUNCTION

' ============ MAIN LOOP ============
BUFFERENABLED YES
running? = YES

WHILE running?
  now# = RUNNINGTIME#

  ' Input (always read)
  handleInput

  IF gameState# = STATE_PLAY# THEN
    ' Shooting, passing, and checking
    handleShooting
    handlePassing
    handleChecking

    ' Movement
    moveActivePlayer
    updateTeammateAI
    updateOpponentAI
    updateGoalieAI
    updatePlayerPhysics

    ' Puck physics, checking, and goals
    updatePuck
    handleOpponentChecking
    checkGoals

    ' Animation and camera
    updateAnimations
    updateCamera

    ' Draw
    CLEARBUFFER
    drawRink
    drawPlayers
    drawPuck
    drawScore

  ELSE IF gameState# = STATE_FIGHT# THEN
    updateFight
    updateCamera

    ' Draw
    CLEARBUFFER
    drawRink
    drawPlayers
    drawPuck
    drawScore
    drawFight
  END IF

  SHOWBUFFER
  SLEEP 0.016
END WHILE
