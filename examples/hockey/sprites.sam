' ============================================
'   HOCKEY SPRITE WRITER
'   Run this once to write all sprite data
'   to localStorage for the hockey game.
' ============================================

' Hex lookup: index 0→"..", 1→"01", etc.
hex@ = ["..", "01", "02", "03", "04", "05", "06", "07", "08", "09", "0A", "0B", "0C", "0D", "0E", "0F", "10"]

' Write a 2D array as a .spr file
FUNCTION writeSpr NAME name$ DATA data@
  f# = OPEN# FILE name$ MODE WRITE
  FOR row# FROM 1 TO LENGTH# data@
    line$ = ""
    FOR col# FROM 1 TO LENGTH# data@[row#]
      IF col# > 1 THEN
        line$ = line$ + " "
      END IF
      v# = data@[row#][col#]
      line$ = line$ + hex@[v# + 1]
    END FOR
    WRITEFILELINE FILE f# LINE line$
  END FOR
  CLOSE f#
  PRINT "Wrote " + name$
END FUNCTION

' ============================================
' COLOR KEY (1-based palette indices):
'   0  = transparent
'   1  = black (outline/stick)
'   3  = dark green (Whalers jersey/helmet)
'   8  = light gray (skin)
'   9  = dark gray (skates)
'  10  = bright blue (Whalers pants)
'  13  = bright red (Opponent jersey/helmet)
'   7  = brown (goalie equipment: glove, blocker, pads)
'  16  = white (shoulder trim)
' ============================================

